@{
    Layout = "~/Views/Themes/RestaurantMenu/_LayoutRestaurant.cshtml";
    var restaurant = ViewBag.Restaurant as EntityLayer.Concrete.Restaurant;
    var categories = ViewBag.Categories as List<EntityLayer.Concrete.Category>;
    var menuItems = ViewBag.MenuItems as List<EntityLayer.Concrete.MenuItem>;
    var theme = ViewBag.Theme as EntityLayer.Concrete.Theme;
    ViewData["Title"] = restaurant?.Name + " Menüsü";

    var rawThemeName = theme?.Name ?? "Modern Minimalist";
    var partialViewName = rawThemeName switch
    {
        "Modern Minimalist"           => "Minimalist",
        "Sıcak & Rustik"              => "Nordic",
        "Koyu & Lüks"                 => "Midnight",
        "Renkli & Eğlenceli"          => "Cyberpunk",
        "Editöryal & Kalın Tipografi" => "Brutalist",
        "Mobil Bistro"                => "Bistro",
        "Ay Cafe"                     => "AyCafe",
        "Klasik Elegance"             => "Elegance",
        "Anadolu Klasik"              => "Anadolu",
        "Eski Gazete Kültürü"         => "VintageNewspaper",
        "Uzak Doğu Esintisi"          => "OrientalJade",
        "Pastel Günbatımı"            => "SunsetCafe",
        "Bento Düzeni"                => "BentoGrid",
        "Ege Rüzgarı"                 => "CoastalAegean",
        "Fütüristik Neon Diner"       => "CyberDiner",
        "Sıcak Odun Ateşi"            => "RusticHearth",
        "Lüks Akşam Yemeği"           => "MidnightBistro",
        "Endüstriyel Minimalist"      => "MinimalistV2",
        _                             => "Minimalist"
    };
}

@section Styles {
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts Imports -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&family=JetBrains+Mono:wght@400;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Anton&family=Space+Grotesk:wght@300;400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

    <style>
        /* Font custom utility mappings */
        .font-sans { font-family: "Inter", ui-sans-serif, system-ui, sans-serif; }
        .font-serif { font-family: "Playfair Display", "Cormorant Garamond", serif; }
        .font-mono { font-family: "JetBrains Mono", ui-monospace, monospace; }
        .font-display { font-family: "Anton", sans-serif; }
        .font-modern { font-family: "Space Grotesk", sans-serif; }
        .font-classic { font-family: "Libre Baskerville", serif; }

        /* Smooth scroll */
        html {
            scroll-behavior: smooth;
        }
        body {
            background-color: #f5f5f5;
        }
    </style>
}

@if (categories == null || !categories.Any())
{
    <div class="max-w-2xl mx-auto my-20 p-8 bg-white border border-neutral-200 rounded-2xl text-center shadow-sm">
        <span class="text-5xl block mb-6">📋</span>
        <h3 class="text-xl font-bold text-neutral-800 mb-2">Bu restoranın henüz menüsü yok</h3>
        <p class="text-neutral-500">Restoran panelinden kategori ve ürünler ekleyebilirsiniz.</p>
    </div>
}
else
{
    <!-- Dinamik Tema Kısmi Görünümü Yükleniyor -->
    @await Html.PartialAsync($"Themes/_{partialViewName}")
}

@if (restaurant?.Id == 0)
{
    <a href="/" class="fixed bottom-6 right-6 z-[9999] flex items-center gap-2 bg-stone-900/90 text-white hover:bg-stone-800 backdrop-blur-md border border-white/10 px-4 py-2.5 rounded-full shadow-2xl transition-all duration-300 hover:-translate-y-0.5 text-xs font-semibold uppercase tracking-wider decoration-none" style="text-decoration: none !important;">
        <span>← Demodan Çık</span>
    </a>
}

@if (restaurant != null)
{
    <!-- Sol Altta Sabit QR Kodu Göster Butonu -->
    <button onclick="document.getElementById('qrModal').classList.remove('hidden')" class="fixed bottom-6 left-6 z-[9999] flex items-center gap-2 bg-stone-900/95 text-white hover:bg-stone-800 backdrop-blur-md border border-white/20 px-4 py-2.5 rounded-full shadow-2xl transition-all duration-300 hover:scale-105 text-xs font-bold uppercase tracking-wider cursor-pointer shadow-stone-900/20">
        <span class="text-base">📱</span>
        <span>QR Kod</span>
    </button>

    <!-- QR Kodu Modalı -->
    <div id="qrModal" class="hidden fixed inset-0 z-[10000] flex items-center justify-center bg-black/60 backdrop-blur-sm p-4" onclick="if(event.target === this) this.classList.add('hidden')">
        <div class="bg-white rounded-3xl p-6 sm:p-8 max-w-sm w-full text-center shadow-2xl relative border border-stone-100">
            <button onclick="document.getElementById('qrModal').classList.add('hidden')" class="absolute top-4 right-4 text-stone-400 hover:text-stone-700 w-8 h-8 rounded-full bg-stone-100 flex items-center justify-center font-bold text-sm">✕</button>
            
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-amber-100 text-amber-800 text-2xl mb-3">📱</div>
            <h3 class="text-lg font-bold text-stone-900 mb-1">@restaurant.Name</h3>
            <p class="text-xs text-stone-500 mb-5">Menüyü başkalarıyla paylaşmak için QR kodu taratın veya indirin.</p>

            <div class="bg-stone-50 p-4 rounded-2xl border border-stone-200/60 inline-block mb-5 shadow-inner">
                <img src="/Menu/@restaurant.Slug/qr" alt="@restaurant.Name QR Kodu" class="w-48 h-48 mx-auto rounded-xl shadow-sm bg-white p-2 border border-stone-100" />
            </div>

            <div class="space-y-2">
                <a href="/Menu/@restaurant.Slug/qr" download="@(restaurant.Slug)_QRCode.png" class="flex items-center justify-center gap-2 w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2.5 px-4 rounded-xl text-xs transition-colors shadow-sm">
                    <span>⬇️</span>
                    <span>QR Kodu İndir (PNG)</span>
                </a>
                <button type="button" onclick="navigator.clipboard.writeText(window.location.href); alert('Menü adresi kopyalandı!');" class="flex items-center justify-center gap-2 w-full bg-stone-100 hover:bg-stone-200 text-stone-800 font-semibold py-2.5 px-4 rounded-xl text-xs transition-colors border border-stone-200 cursor-pointer">
                    <span>📋</span>
                    <span>Menü Linkini Kopyala</span>
                </button>
            </div>
        </div>
    </div>
}

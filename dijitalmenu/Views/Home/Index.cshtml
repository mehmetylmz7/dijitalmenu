<!-- ─── BENTO GRID FEATURES ─── -->
<section class="features-section" id="features">
    <div class="section-header-center">
        <h2>RESTORANINIZ İÇİN İHTİYACINIZ OLAN HER ŞEY</h2>
        <p>Modern, hızlı ve kolay yönetilen bir deneyimle müşterilerinizi etkileyin ve satışlarınızı artırın.</p>
    </div>

    <div class="bento-grid">
        <div class="bento-card">
            <div class="bento-icon-box">
                <span class="material-symbols-outlined">qr_code_scanner</span>
            </div>
            <h3>QR Menü Deneyimi</h3>
            <p>Müşterileriniz masadaki QR kodu okutarak anında güncel menünüze ulaşır. Uygulama indirme gerektirmeyen kusursuz mobil erişim.</p>
        </div>

        <div class="bento-card">
            <div class="bento-icon-box">
                <span class="material-symbols-outlined">edit_document</span>
            </div>
            <h3>Kolay Yönetim</h3>
            <p>Fiyatları, ürün açıklamalarını ve stok durumunu saniyeler içinde güncelleyin. Tüm değişiklikler anında masalara yansır.</p>
        </div>

        <div class="bento-card">
            <div class="bento-icon-box">
                <span class="material-symbols-outlined">palette</span>
            </div>
            <h3>18+ Modern Tasarım</h3>
            <p>Markanıza en uygun renkleri, profesyonel tipografiyi ve iştah açıcı düzenleri tek tıkla seçip özelleştirin.</p>
        </div>
    </div>
</section>

<!-- ─── HOW IT WORKS (PROCESS) ─── -->
<section class="process-section" id="how-it-works">
    <div class="process-container">
        <div class="section-header-center">
            <h2>Nasıl Çalışır?</h2>
            <p>3 basit adımda dijital menünüzü hazırlayın ve hemen yayınlayın.</p>
        </div>

        <div class="process-grid">
            <div class="process-step">
                <div class="step-number">01</div>
                <h4>Hesap Oluştur</h4>
                <p>Saniyeler içinde ücretsiz kaydınızı açın ve restoran bilgilerinizi tanımlayın.</p>
            </div>

            <div class="process-step">
                <div class="step-number">02</div>
                <h4>Menünü Hazırla</h4>
                <p>Kategorilerinizi, ürünlerinizi, fiyatlarınızı ve fotoğraflarınızı kolayca ekleyin.</p>
            </div>

            <div class="process-step">
                <div class="step-number">03</div>
                <h4>QR Kodu Paylaş</h4>
                <p>Oluşturulan sabit QR kodunuzu indirin, masalarınıza yerleştirin ve servise başlayın.</p>
            </div>
        </div>
    </div>
</section>

<!-- ─── LIVE THEMES SHOWCASE ─── -->
<section class="themes-section" id="demo">
    <div class="section-header-center">
        <h2>🎨 Canlı Tema Galerisi</h2>
        <p>Her temaya tıklayarak gerçek bir menü deneyimi yaşayın. Tüm temalar %100 mobil uyumludur.</p>
    </div>

    <div class="themes-grid">
        @{
            var themeMap = new System.Collections.Generic.Dictionary<string, int>();
            foreach (var t in themes)
            {
                if (!themeMap.ContainsKey(t.Name))
                    themeMap[t.Name] = t.Id;
            }
        }

        @foreach (var demo in demoThemes)
        {
            var themeId = themeMap.ContainsKey(demo.Name) ? themeMap[demo.Name] : 1;
            var href = $"/Home/Preview?themeId={themeId}";

            <a class="theme-card" href="@href" target="_blank" rel="noopener">
                <div class="theme-card-thumb">
                    <div class="live-chip">Canlı Demo</div>
                    <span>@demo.Emoji</span>
                </div>

                <div class="theme-card-body">
                    <div class="theme-card-title">@demo.Emoji @demo.Name</div>
                    <div class="theme-card-desc">@demo.Desc</div>

                    <div class="theme-card-footer">
                        <span class="theme-tag">Hazır Tema</span>
                        <div class="theme-cta">
                            <span>Önizle</span>
                            <span>→</span>
                        </div>
                    </div>
                </div>
            </a>
        }
    </div>
</section>


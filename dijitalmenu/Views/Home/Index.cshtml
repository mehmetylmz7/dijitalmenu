@{
    ViewData["Title"] = "Dijital Menü — Modern Restoran Menü Platformu";
    var themes = ViewBag.Themes as List<EntityLayer.Concrete.Theme> ?? new();

    // Tema adı → (emoji, açıklama, renk sınıfı, previewThemeId)
    var demoThemes = new[]
    {
        new { Name = "Modern Minimalist",           Emoji = "⬜",  Desc = "Sade, temiz ve zamansız. Marka kimliğini ön plana çıkar.",    Accent = "#6c63ff", Border = "rgba(108,99,255,.35)",  Shadow = "rgba(108,99,255,.18)" },
        new { Name = "Sıcak & Rustik",              Emoji = "🪵",  Desc = "Nordic ahşap dokusu. Sıcak ve samimi atmosfer.",             Accent = "#e07b39", Border = "rgba(224,123,57,.35)",  Shadow = "rgba(224,123,57,.18)" },
        new { Name = "Koyu & Lüks",                 Emoji = "🌙",  Desc = "Midnight karanlığında altın detaylar. Premium his.",         Accent = "#d4af37", Border = "rgba(212,175,55,.35)",  Shadow = "rgba(212,175,55,.18)" },
        new { Name = "Renkli & Eğlenceli",          Emoji = "⚡",  Desc = "Neon ışıltısı, cyberpunk enerjisi. Cesur ve dikkat çekici.", Accent = "#ff007a", Border = "rgba(255,0,122,.35)",   Shadow = "rgba(255,0,122,.18)"  },
        new { Name = "Editöryal & Kalın Tipografi", Emoji = "🗞️", Desc = "Brutalist tasarım. Güçlü tipografi ile etkileyici duruş.",  Accent = "#f5c518", Border = "rgba(245,197,24,.35)",  Shadow = "rgba(245,197,24,.18)" },
        new { Name = "Mobil Bistro",                Emoji = "📱",  Desc = "Modern mobil kart tasarımı. Chip filtreli, akıcı deneyim.", Accent = "#ef233c", Border = "rgba(239,35,60,.35)",   Shadow = "rgba(239,35,60,.18)"  },
        new { Name = "Ay Cafe",                     Emoji = "☕",  Desc = "Sticky kategori nav, liste menü, yıldızlı footer.",         Accent = "#ff6b6b", Border = "rgba(255,107,107,.35)", Shadow = "rgba(255,107,107,.18)"},
        new { Name = "Klasik Elegance",             Emoji = "🌿",  Desc = "Koyu çam yeşili ve mat altın detaylar. Fraunces fontu ile seçkin menü.", Accent = "#37463b", Border = "rgba(55,70,59,.35)", Shadow = "rgba(55,70,59,.18)"},
        new { Name = "Anadolu Klasik",              Emoji = "🍲",  Desc = "Görsel kartlı ızgara tasarımı, servis bilgilendirme kartı, koyu altlık.", Accent = "#78350f", Border = "rgba(120,53,15,.35)", Shadow = "rgba(120,53,15,.18)"},
        new { Name = "Eski Gazete Kültürü",         Emoji = "📰",  Desc = "Eski nostaljik gazete mizanpajı, sepya ve çift çizgili kenarlıklar.", Accent = "#2d1e10", Border = "rgba(45,30,16,.35)", Shadow = "rgba(45,30,16,.18)"},
        new { Name = "Uzak Doğu Esintisi",          Emoji = "⛩️",  Desc = "Koyu zümrüt yeşili ve mat altın tonlarında zen stili menü tasarımı.", Accent = "#d4af37", Border = "rgba(212,175,55,.35)", Shadow = "rgba(212,175,55,.18)"},
        new { Name = "Pastel Günbatımı",            Emoji = "🌇",  Desc = "Yumuşak şeftali ve günbatımı renkleri, yuvarlatılmış geniş köşeler.", Accent = "#ff793f", Border = "rgba(255,121,63,.35)", Shadow = "rgba(255,121,63,.18)"},
        new { Name = "Bento Düzeni",                Emoji = "🍱",  Desc = "Bento kutusu şeklinde modern parçalı grid yerleşimi ve adres kartı.", Accent = "#b45309", Border = "rgba(180,83,9,.35)", Shadow = "rgba(180,83,9,.18)"},
        new { Name = "Ege Rüzgarı",                 Emoji = "⚓",  Desc = "Mavi ve beyaz Akdeniz rüzgarı, deniz ürünleri için harika marin.", Accent = "#0284c7", Border = "rgba(2,132,199,.35)", Shadow = "rgba(2,132,199,.18)"},
        new { Name = "Fütüristik Neon Diner",       Emoji = "👾",  Desc = "Siberpunk neon renkleri, terminal kod yazı tipleri, sistem uyarıları.", Accent = "#00f0ff", Border = "rgba(0,240,255,.35)", Shadow = "rgba(0,240,255,.18)"},
        new { Name = "Sıcak Odun Ateşi",            Emoji = "🔥",  Desc = "Toprak tonlarında sıcak fırın, odun ateşi logolu şömine konsepti.", Accent = "#c0603d", Border = "rgba(192,96,61,.35)", Shadow = "rgba(192,96,61,.18)"},
        new { Name = "Lüks Akşam Yemeği",           Emoji = "🍷",  Desc = "Sinematik karanlık arka plan, altın yıldızlı premium şef yemekleri.", Accent = "#f59e0b", Border = "rgba(245,158,11,.35)", Shadow = "rgba(245,158,11,.18)"},
        new { Name = "Endüstriyel Minimalist",      Emoji = "🛠️",  Desc = "Neobrutalist kalın siyah çizgiler, gölgeli kutular ve sade düzen.", Accent = "#111111", Border = "rgba(17,17,17,.35)", Shadow = "rgba(17,17,17,.18)"},
    };
}

@section Styles {
<style>
    /* ─── Hero ─── */
    .hero {
        background: radial-gradient(ellipse at 40% 0%, rgba(108,99,255,.28) 0%, transparent 60%),
                    radial-gradient(ellipse at 85% 55%, rgba(167,139,250,.14) 0%, transparent 50%),
                    radial-gradient(ellipse at 10% 80%, rgba(96,165,250,.10) 0%, transparent 45%);
        padding: 96px 24px 72px;
        text-align: center;
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(108,99,255,.15);
        border: 1px solid rgba(108,99,255,.3);
        border-radius: 100px;
        padding: 6px 18px;
        font-size: .8rem;
        font-weight: 600;
        color: #a78bfa;
        letter-spacing: .04em;
        text-transform: uppercase;
        margin-bottom: 28px;
        animation: fadeDown .6s ease both;
    }

    .hero-badge span { animation: pulse 2s infinite; }

    .hero h1 {
        font-size: clamp(2.4rem, 6vw, 4rem);
        font-weight: 800;
        line-height: 1.12;
        margin-bottom: 20px;
        animation: fadeUp .7s ease .1s both;
    }

    .hero h1 .gradient {
        background: linear-gradient(135deg, #6c63ff 0%, #a78bfa 50%, #60a5fa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero p {
        color: #8892a4;
        font-size: 1.15rem;
        max-width: 520px;
        margin: 0 auto 36px;
        line-height: 1.75;
        animation: fadeUp .7s ease .2s both;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
        animation: fadeUp .7s ease .3s both;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #6c63ff, #a78bfa);
        color: #fff;
        padding: 13px 28px;
        border-radius: 12px;
        font-weight: 700;
        font-size: .95rem;
        text-decoration: none;
        transition: transform .2s, box-shadow .2s;
        box-shadow: 0 4px 24px rgba(108,99,255,.35);
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(108,99,255,.45);
        color: #fff;
    }

    .btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.12);
        color: #c4c9d6;
        padding: 13px 28px;
        border-radius: 12px;
        font-weight: 600;
        font-size: .95rem;
        text-decoration: none;
        transition: all .2s;
        backdrop-filter: blur(6px);
    }

    .btn-secondary:hover {
        background: rgba(255,255,255,.10);
        border-color: rgba(255,255,255,.22);
        color: #e2e8f0;
    }

    /* ─── Stats Bar ─── */
    .stats-bar {
        display: flex;
        justify-content: center;
        gap: 48px;
        flex-wrap: wrap;
        padding: 32px 24px;
        border-top: 1px solid rgba(255,255,255,.06);
        border-bottom: 1px solid rgba(255,255,255,.06);
        background: rgba(255,255,255,.02);
        animation: fadeUp .7s ease .4s both;
    }

    .stat-item {
        text-align: center;
    }

    .stat-item strong {
        display: block;
        font-size: 1.8rem;
        font-weight: 800;
        background: linear-gradient(135deg, #6c63ff, #a78bfa);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .stat-item span {
        font-size: .82rem;
        color: #8892a4;
        letter-spacing: .03em;
    }

    /* ─── Demo Section ─── */
    .demo-section {
        max-width: 1200px;
        margin: 0 auto;
        padding: 72px 24px 96px;
    }

    .demo-section-header {
        text-align: center;
        margin-bottom: 52px;
    }

    .demo-section-header h2 {
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        font-weight: 800;
        margin-bottom: 12px;
    }

    .demo-section-header p {
        color: #8892a4;
        font-size: 1rem;
        max-width: 460px;
        margin: 0 auto;
        line-height: 1.7;
    }

    .demo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
        gap: 24px;
    }

    /* ─── Demo Card ─── */
    .demo-card {
        position: relative;
        background: #1a1d27;
        border: 1px solid #2d3148;
        border-radius: 22px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        transition: transform .3s cubic-bezier(.34,1.56,.64,1), border-color .25s, box-shadow .3s;
        group: true;
    }

    .demo-card:hover {
        transform: translateY(-6px) scale(1.01);
    }

    .demo-card-thumb {
        height: 160px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
        background: linear-gradient(135deg, #21253a, #2d3148);
        position: relative;
        overflow: hidden;
    }

    .demo-card-thumb .preview-label {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(0,0,0,.5);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 8px;
        padding: 4px 10px;
        font-size: .72rem;
        font-weight: 600;
        color: #c4c9d6;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .demo-card-thumb .live-dot {
        position: absolute;
        top: 12px;
        left: 12px;
        display: flex;
        align-items: center;
        gap: 5px;
        background: rgba(0,0,0,.5);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 8px;
        padding: 4px 10px;
        font-size: .72rem;
        font-weight: 600;
        color: #4ade80;
        letter-spacing: .04em;
    }

    .live-dot::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #4ade80;
        animation: blink 1.5s infinite;
    }

    .demo-card-body {
        padding: 22px 22px 18px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .demo-card-body h3 {
        font-size: 1.05rem;
        font-weight: 700;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .demo-card-body p {
        font-size: .85rem;
        color: #8892a4;
        line-height: 1.6;
        flex: 1;
        margin-bottom: 18px;
    }

    .demo-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 14px;
        border-top: 1px solid rgba(255,255,255,.06);
    }

    .demo-card-tag {
        font-size: .75rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 20px;
        background: rgba(255,255,255,.06);
        color: #8892a4;
        letter-spacing: .03em;
    }

    .demo-cta {
        font-size: .85rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: gap .2s;
    }

    .demo-card:hover .demo-cta { gap: 9px; }

    /* ─── Glow overlay on hover ─── */
    .demo-card::before {
        content: '';
        position: absolute;
        inset: 0;
        opacity: 0;
        border-radius: 22px;
        transition: opacity .3s;
        pointer-events: none;
    }

    .demo-card:hover::before { opacity: 1; }

    /* ─── CTA Section ─── */
    .cta-section {
        text-align: center;
        padding: 64px 24px 96px;
        background: radial-gradient(ellipse at 50% 0%, rgba(108,99,255,.18) 0%, transparent 65%);
    }

    .cta-section h2 {
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 800;
        margin-bottom: 12px;
    }

    .cta-section p {
        color: #8892a4;
        font-size: 1rem;
        max-width: 400px;
        margin: 0 auto 32px;
        line-height: 1.7;
    }

    /* ─── Animations ─── */
    @@keyframes fadeUp   { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
    @@keyframes fadeDown { from { opacity: 0; transform: translateY(-12px); } to { opacity: 1; transform: none; } }
    @@keyframes pulse    { 0%,100% { opacity: 1; } 50% { opacity: .5; } }
    @@keyframes blink    { 0%,100% { opacity: 1; } 50% { opacity: .3; } }
</style>
}

<!-- ─── HERO ─── -->
<div class="hero">
    <div class="hero-badge">
        <span>✨</span> @(ViewBag.Themes?.Count ?? 18) Hazır Tema · Anında Yayınla
    </div>
    <h1>
        Restoranınız için<br>
        <span class="gradient">Dijital Menü</span>
    </h1>
    <p>QR kod ile müşterilerinize anında menü sunan, profesyonel görünümlü ve tamamen özelleştirilebilir dijital menü platformu.</p>
    <div class="hero-actions">
        <a href="/Restaurant/Auth/Login" class="btn-primary" id="btn-restaurant-login">
            🍃 Restoranım için başlat
        </a>
        <a href="#demo" class="btn-secondary" id="btn-see-demos">
            🎨 Temaları keşfet
        </a>
    </div>
</div>

<!-- ─── STATS ─── -->
<div class="stats-bar">
    <div class="stat-item">
        <strong>5</strong>
        <span>Hazır Tema</span>
    </div>
    <div class="stat-item">
        <strong>QR</strong>
        <span>Kod Desteği</span>
    </div>
    <div class="stat-item">
        <strong>∞</strong>
        <span>Kategori & Ürün</span>
    </div>
    <div class="stat-item">
        <strong>100%</strong>
        <span>Mobil Uyumlu</span>
    </div>
</div>

<!-- ─── DEMO THEMES ─── -->
<div class="demo-section" id="demo">
    <div class="demo-section-header">
        <h2>🎨 Canlı Tema Önizlemeleri</h2>
        <p>Her temaya tıklayarak gerçek bir menü deneyimi yaşayın. Hepsi tamamen mobil uyumlu.</p>
    </div>

    <div class="demo-grid">
        @{
            // DB'deki gerçek restoranı demo için kullan (ilk mevcut restoran)
            // Tema eşleme: DB'de kayıtlı temalar arasından eşleştir
            var themeMap = new System.Collections.Generic.Dictionary<string, int>();
            foreach (var t in themes)
            {
                if (!themeMap.ContainsKey(t.Name))
                    themeMap[t.Name] = t.Id;
            }
        }

        @foreach (var demo in demoThemes)
        {
            var themeId = themeMap.ContainsKey(demo.Name) ? themeMap[demo.Name] : 1;
            var href = $"/Home/Preview?themeId={themeId}";
            var cardStyle = $"border-color:{demo.Border}; box-shadow:0 0 0 0 {demo.Shadow};";
            var hoverGlow = $"background: radial-gradient(ellipse at 50% 0%, {demo.Shadow.Replace("18)", "08)")} 0%, transparent 70%);";
            var ctaColor = $"color:{demo.Accent}";

            <a class="demo-card" href="@href" id="demo-@demo.Name.Replace(" ", "-").Replace("&", "").Replace("ı","i").Replace("ğ","g").ToLower()"
               style="@cardStyle"
               onmouseenter="this.style.boxShadow='0 16px 48px @demo.Shadow'"
               onmouseleave="this.style.boxShadow='0 0 0 0 @demo.Shadow'">

                <div class="demo-card-thumb">
                    <span class="live-dot">Canlı Demo</span>
                    @demo.Emoji
                    <span class="preview-label">Önizle →</span>
                </div>

                <div class="demo-card-body">
                    <h3>@demo.Emoji @demo.Name</h3>
                    <p>@demo.Desc</p>
                    <div class="demo-card-footer">
                        <span class="demo-card-tag">Tema</span>
                        <span class="demo-cta" style="@ctaColor">
                            Dene <span>→</span>
                        </span>
                    </div>
                </div>
            </a>
        }
    </div>
</div>

<!-- ─── CTA ─── -->
<div class="cta-section">
    <h2>Restoranınızı dijitale taşıyın 🚀</h2>
    <p>Ücretsiz hesap oluşturun, menünüzü dakikalar içinde hazırlayın ve QR kodunuzu müşterilerinizle paylaşın.</p>
    <div class="hero-actions">
        <a href="/Restaurant/Auth/Login" class="btn-primary" id="btn-cta-start">
            Hemen Başla — Ücretsiz
        </a>
        <a href="/Admin/Auth/Login" class="btn-secondary" id="btn-cta-admin">
            ⚙️ Admin Paneli
        </a>
    </div>
</div>

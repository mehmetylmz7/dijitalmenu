@{ ViewData["Title"] = "Restoranınızın Menüsü Artık Telefonda — Dijital Menü"; var themes = ViewBag.Themes as List<EntityLayer.Concrete.Theme> ?? new(); }
@section Styles {<style>
.home-hero{max-width:1180px;margin:auto;padding:92px 24px 110px;display:grid;grid-template-columns:1.05fr .95fr;gap:72px;align-items:center}.eyebrow{display:inline-flex;gap:8px;align-items:center;color:#047857;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.eyebrow:before{content:'';width:26px;height:1px;background:#f59e0b}.hero-title{font:800 clamp(44px,6vw,76px)/1.02 Manrope;letter-spacing:-.07em;margin:22px 0;color:#1c1917}.hero-title em{color:#047857;font-style:normal}.hero-copy{max-width:540px;color:#78716c;font-size:18px;line-height:1.7}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.hero-primary,.hero-secondary{padding:14px 20px;border-radius:12px;text-decoration:none;font-weight:700;font-size:14px;transition:.25s}.hero-primary{background:#064e3b;color:#fff;box-shadow:0 14px 28px rgba(6,78,59,.2)}.hero-secondary{border:1px solid #d6d3d1;color:#44403c;background:#fff}.hero-primary:hover,.hero-secondary:hover{transform:translateY(-2px)}.proof{display:flex;align-items:center;gap:14px;margin-top:34px;color:#78716c;font-size:13px}.proof strong{color:#1c1917}.hero-visual{position:relative;min-height:520px;display:grid;place-items:center}.glow{position:absolute;width:410px;height:410px;border-radius:50%;background:radial-gradient(circle,#fde68a 0,rgba(253,230,138,0) 68%);opacity:.55}.phone{position:relative;width:280px;height:510px;border:8px solid #1c1917;border-radius:38px;background:#fafaf9;box-shadow:24px 32px 70px rgba(28,25,23,.2);overflow:hidden;transform:rotate(3deg)}.phone:before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:96px;height:22px;background:#1c1917;border-radius:0 0 14px 14px;z-index:2}.phone-top{padding:38px 18px 18px;background:#064e3b;color:white}.phone-top small{opacity:.6}.phone-top h3{font:700 24px Manrope;margin:8px 0}.phone-tabs{display:flex;gap:16px;padding:14px 18px;white-space:nowrap;border-bottom:1px solid #e7e5e4;color:#78716c;font-size:11px}.phone-tabs b{color:#047857;border-bottom:2px solid #f59e0b;padding-bottom:8px}.dish{margin:14px;padding:14px;border:1px solid #e7e5e4;border-radius:16px;background:white;display:flex;gap:12px}.dish-art{width:54px;height:54px;border-radius:12px;background:linear-gradient(135deg,#fbbf24,#fef3c7)}.dish:nth-child(3) .dish-art{background:linear-gradient(135deg,#34d399,#d1fae5)}.dish h4{margin:0 0 5px;font:700 13px Manrope}.dish p{margin:0;color:#a8a29e;font-size:10px}.dish strong{display:block;margin-top:7px;color:#047857;font-size:12px}.floating-note{position:absolute;right:2%;bottom:65px;background:rgba(255,255,255,.88);backdrop-filter:blur(12px);border:1px solid #e7e5e4;border-radius:14px;padding:14px 16px;box-shadow:0 18px 35px rgba(28,25,23,.12);font-size:12px;color:#57534e}.floating-note b{display:block;color:#1c1917;font-size:18px;margin-bottom:3px}.section{max-width:1180px;margin:auto;padding:94px 24px}.section-head{max-width:620px;margin-bottom:42px}.section-kicker{color:#047857;font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.section h2{font:800 clamp(32px,4vw,52px)/1.08 Manrope;letter-spacing:-.06em;margin:14px 0;color:#1c1917}.section-head p{color:#78716c;line-height:1.7}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.feature{padding:26px;border:1px solid #e7e5e4;border-radius:20px;background:#fff;transition:.3s}.feature:hover{transform:translateY(-5px);box-shadow:0 18px 40px rgba(28,25,23,.08);border-color:#a7f3d0}.feature-mark{color:#f59e0b;font-weight:800;font-size:20px}.feature h3{font:700 18px Manrope;margin:22px 0 8px}.feature p{color:#78716c;line-height:1.6;font-size:14px;margin:0}.theme-strip{display:flex;gap:12px;overflow:auto;padding-bottom:8px}.theme-card{min-width:190px;padding:18px;border-radius:16px;color:#fff;background:linear-gradient(145deg,#064e3b,#14532d);min-height:130px}.theme-card:nth-child(2n){background:linear-gradient(145deg,#78350f,#d97706)}.theme-card:nth-child(3n){background:linear-gradient(145deg,#292524,#a16207)}.theme-card h4{font:700 15px Manrope;margin:28px 0 0}.theme-card p{font-size:11px;opacity:.72;margin:5px 0}@@media(max-width:800px){.home-hero{grid-template-columns:1fr;padding:64px 20px 80px;gap:30px}.hero-visual{min-height:470px}.feature-grid{grid-template-columns:1fr}.section{padding:70px 20px}.floating-note{right:0;bottom:25px}}
</style>}
<section class="home-hero"><div><span class="eyebrow">Restoranlar için yeni nesil menü</span><h1 class="hero-title">Menünüzü <em>dijitalleştirin.</em><br />Lezzetinizi büyütün.</h1><p class="hero-copy">QR kodla saniyeler içinde açılan, markanıza özel ve her cihazda kusursuz görünen menüler. Değişiklikler anında yayında.</p><div class="hero-actions"><a class="hero-primary" asp-area="Restaurant" asp-controller="Auth" asp-action="Register">Menümü oluşturmaya başla →</a><a class="hero-secondary" href="#demo">Canlı menüyü incele</a></div><div class="proof"><strong>4.9/5</strong><span>Restoran sahipleri tarafından seviliyor</span></div></div><div class="hero-visual"><div class="glow"></div><div class="phone"><div class="phone-top"><small>Hoş geldiniz</small><h3>Olive & Stone</h3><span>Mevsimsel mutfak · İstanbul</span></div><div class="phone-tabs"><b>Öne çıkanlar</b><span>Başlangıçlar</span><span>Ana yemekler</span></div><div class="dish"><div class="dish-art"></div><div><h4>Izgara levrek</h4><p>Limon, rezene, zeytinyağı</p><strong>₺420</strong></div></div><div class="dish"><div class="dish-art"></div><div><h4>Bahçe salatası</h4><p>Yerel yeşillikler, nar ekşisi</p><strong>₺180</strong></div></div></div><div class="floating-note"><b>+24%</b>menü görüntülenmesi</div></div></section>
<section class="section" id="features"><div class="section-head"><span class="section-kicker">Sade. Hızlı. Şık.</span><h2>İyi bir menü, iyi bir ilk izlenimdir.</h2><p>Misafirlerinizin deneyimini ilk dokunuştan son siparişe kadar markanızın kalitesinde tutun.</p></div><div class="feature-grid"><div class="feature"><span class="feature-mark">01</span><h3>Markanıza özel</h3><p>Renkleriniz, tipografiniz ve atmosferiniz için seçilmiş modern tema koleksiyonu.</p></div><div class="feature"><span class="feature-mark">02</span><h3>Anında güncelleyin</h3><p>Fiyat, içerik veya ürün değişikliklerini baskı beklemeden tek panelden yönetin.</p></div><div class="feature"><span class="feature-mark">03</span><h3>Sabit QR kod</h3><p>Menünüz değişse bile masalarınızdaki QR baskıları her zaman çalışmaya devam eder.</p></div></div></section>
<section class="section" id="demo"><div class="section-head"><span class="section-kicker">Tema galerisi</span><h2>Restoranınızın karakterini yansıtın.</h2></div><div class="theme-strip">@foreach (var theme in themes.Take(8)) { <div class="theme-card"><span>●</span><h4>@theme.Name</h4><p>Canlı menü teması</p></div> }</div></section>
<section class="section" id="how-it-works"><div class="section-head"><span class="section-kicker">Üç adımda hazır</span><h2>Bugün başlayın, bugün yayınlayın.</h2></div><div class="feature-grid"><div class="feature"><span class="feature-mark">01</span><h3>Hesabınızı açın</h3><p>Restoran bilgilerinizi girin ve size en uygun başlangıç temasını seçin.</p></div><div class="feature"><span class="feature-mark">02</span><h3>Menünüzü ekleyin</h3><p>Kategorilerinizi ve ürünlerinizi kolay yönetim panelinden oluşturun.</p></div><div class="feature"><span class="feature-mark">03</span><h3>QR kodu paylaşın</h3><p>QR kodunuzu masalara koyun. Misafirleriniz menünüze anında ulaşsın.</p></div></div></section>

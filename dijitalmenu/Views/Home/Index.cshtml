<!-- ─── LIVE THEMES SHOWCASE ─── -->
<section class="themes-section" id="demo">
    @{
        var themeMap = new System.Collections.Generic.Dictionary<string, int>();
        foreach (var t in themes)
        {
            if (!themeMap.ContainsKey(t.Name))
                themeMap[t.Name] = t.Id;
        }

        var themeList = demoThemes.Select((d, idx) => new {
            Index = idx,
            Id = themeMap.ContainsKey(d.Name) ? themeMap[d.Name] : 1,
            Name = d.Name,
            Emoji = d.Emoji,
            Desc = d.Desc,
            Accent = d.Accent,
            Border = d.Border,
            Shadow = d.Shadow
        }).ToList();

        var initialTheme = themeList.FirstOrDefault() ?? new {
            Index = 0,
            Id = 1,
            Name = "Modern Minimalist",
            Emoji = "⬜",
            Desc = "Sade, temiz ve zamansız.",
            Accent = "#10B981",
            Border = "rgba(16,185,129,.35)",
            Shadow = "rgba(16,185,129,.15)"
        };

        var themesJson = System.Text.Json.JsonSerializer.Serialize(themeList);
    }

    <div class="section-header-center">
        <div class="theme-tag-pill" style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 16px; font-size: 0.8rem; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 0.04em;">
            <span class="material-symbols-outlined" style="font-size: 1rem;">palette</span>
            <span>18 Farklı Konsept & Canlı Demo</span>
        </div>
        <h2>🎨 Canlı Tema Galerisi</h2>
        <p>Her konsepte özel tasarlanmış mobil menüler. Temalar 10 saniyede bir otomatik akar; dilediğiniz temaya tıklayarak anında test edebilirsiniz.</p>
    </div>

    <!-- ─── Flagship Interactive Stage ─── -->
    <div class="theme-stage-wrapper">
        <!-- Sol Kontrol ve Bilgi Paneli -->
        <div class="theme-control-panel">
            <!-- Aktif Tema Kartı -->
            <div class="theme-active-card" id="themeActiveCard">
                <div class="active-card-glow-bar" id="activeCardGlowBar"></div>

                <div class="theme-active-header">
                    <div class="theme-active-info-left">
                        <div class="theme-emoji-icon" id="activeThemeEmoji">@initialTheme.Emoji</div>
                        <div class="theme-title-box">
                            <h3 class="theme-title-text" id="activeThemeName">@initialTheme.Name</h3>
                            <div class="theme-badges-row">
                                <span class="theme-tag-pill" id="activeThemeTag">@initialTheme.Name</span>
                                <span class="theme-counter-chip" id="activeThemeCounter">1 / @themeList.Count</span>
                            </div>
                        </div>
                    </div>
                </div>

                <p class="theme-active-desc" id="activeThemeDesc">@initialTheme.Desc</p>

                <!-- Kontrol Butonları ve Aksiyonlar -->
                <div class="theme-controls-row">
                    <div class="nav-btn-group">
                        <button type="button" class="theme-nav-btn" onclick="prevThemeShowcase()" title="Önceki Tema">
                            <span class="material-symbols-outlined">chevron_left</span>
                        </button>
                        <button type="button" class="theme-nav-btn" id="themePlayPauseBtn" onclick="toggleThemePlayPause()" title="Otomatik Akışı Duraklat / Başlat">
                            <span class="material-symbols-outlined" id="themePlayPauseIcon">pause</span>
                        </button>
                        <button type="button" class="theme-nav-btn" onclick="nextThemeShowcase()" title="Sonraki Tema">
                            <span class="material-symbols-outlined">chevron_right</span>
                        </button>
                    </div>

                    <div class="theme-action-btns">
                        <a id="themePreviewLinkBtn" href="/Home/Preview?themeId=@initialTheme.Id" target="_blank" rel="noopener" class="btn-preview-simulator">
                            <span class="material-symbols-outlined" style="font-size: 1.1rem;">open_in_new</span>
                            <span>Tam Ekran Simülatör</span>
                        </a>
                        <a asp-area="Restaurant" asp-controller="Auth" asp-action="Register" class="btn-use-theme">
                            <span>Bu Temayla Başla</span>
                            <span class="material-symbols-outlined" style="font-size: 1.1rem;">arrow_forward</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Hızlı Seçim Butonları (18 Tema) -->
            <div class="theme-pills-deck">
                <div class="theme-pills-header">
                    <span>⚡ Hızlı Tema Seçimi (Tıklayarak Hemen Deneyin):</span>
                    <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 500;">Tıklayınca anında yüklenir</span>
                </div>
                <div class="theme-pills-grid" id="themePillsContainer">
                    @for (int i = 0; i < themeList.Count; i++)
                    {
                        var item = themeList[i];
                        <button type="button" class="theme-pill-item @(i == 0 ? "active" : "")" 
                                onclick="selectThemeShowcase(@i)" 
                                data-index="@i" 
                                title="@item.Name (@item.Desc)">
                            <span class="pill-color-dot" style="background-color: @item.Accent;"></span>
                            <span>@item.Emoji @item.Name</span>
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Sağ Canlı Telefon Mockup'ı -->
        <div class="theme-phone-wrapper" id="showcasePhoneStage">
            <div class="phone-ambient-glow" id="phoneAmbientGlow"></div>

            <div class="showcase-phone-frame">
                <!-- Dynamic Island / Notch -->
                <div class="phone-island">
                    <div class="phone-camera-lens"></div>
                </div>

                <!-- Floating Badge -->
                <div class="phone-floating-badge">
                    <span style="color: #10B981;">●</span>
                    <span>Canlı Menü (Kaydırılabilir)</span>
                </div>

                <!-- Sol & Sağ Telefon Üzeri Hızlı Geçiş Butonları -->
                <button type="button" class="phone-floating-arrow arrow-prev" onclick="prevThemeShowcase()" title="Önceki">
                    <span class="material-symbols-outlined">chevron_left</span>
                </button>
                <button type="button" class="phone-floating-arrow arrow-next" onclick="nextThemeShowcase()" title="Sonraki">
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>

                <!-- Phone Iframe Container -->
                <div class="phone-iframe-container">
                    <div class="phone-loader-spinner" id="showcaseIframeLoader">
                        <div class="mini-spinner"></div>
                    </div>
                    <iframe src="/Home/Demo?themeId=@initialTheme.Id&embed=1" class="showcase-iframe" id="showcaseIframe" title="Tema Önizleme Menüsü"></iframe>
                </div>
            </div>

            <!-- Nokta Göstergeleri (Dots) -->
            <div class="phone-bottom-dots" id="themeDotsContainer">
                @for (int i = 0; i < themeList.Count; i++)
                {
                    <span class="theme-dot-item @(i == 0 ? "active" : "")" onclick="selectThemeShowcase(@i)" title="@themeList[i].Name"></span>
                }
            </div>
        </div>
    </div>

    <!-- ─── Secondary 18 Themes Showcase Grid ─── -->
    <div class="theme-secondary-grid-section">
        <div class="theme-grid-header">
            <div>
                <h3>Tüm 18 Restoran Temasını İnceleyin</h3>
                <p style="font-size: 0.9rem; color: var(--text-secondary); margin-top: 4px;">Kartlara tıklayarak doğrudan yukarıdaki canlı telefonda görüntüleyebilirsiniz.</p>
            </div>
            <a href="/Home/Preview?themeId=1" target="_blank" rel="noopener" class="btn-hero-secondary" style="padding: 8px 18px; font-size: 0.85rem;">
                <span class="material-symbols-outlined" style="font-size: 1.1rem;">devices</span>
                <span>Cihaz Simülatörünü Aç</span>
            </a>
        </div>

        <div class="themes-grid">
            @for (int i = 0; i < themeList.Count; i++)
            {
                var item = themeList[i];
                var previewUrl = $"/Home/Preview?themeId={item.Id}";

                <div class="theme-mini-card @(i == 0 ? "active" : "")" onclick="selectThemeAndScroll(@i)" data-card-index="@i">
                    <div class="theme-mini-card-top">
                        <span class="theme-mini-emoji">@item.Emoji</span>
                        <span class="theme-mini-badge" style="border-left: 3px solid @item.Accent;">Hazır Tema</span>
                    </div>

                    <div>
                        <div class="theme-mini-title">@item.Emoji @item.Name</div>
                        <div class="theme-mini-desc">@item.Desc</div>
                    </div>

                    <div class="theme-mini-footer">
                        <div class="theme-mini-btn-sim">
                            <span>Telefonda Dene</span>
                            <span>↑</span>
                        </div>
                        <a href="@previewUrl" target="_blank" rel="noopener" class="theme-mini-btn-full" onclick="event.stopPropagation();" title="Tam Ekran Önizle">
                            <span>Tam Ekran ↗</span>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ─── DARK CTA BANNER ─── -->
<section class="cta-banner-section">
    <div class="cta-banner-card">
        <div class="cta-glow"></div>
        <h2 class="cta-banner-title">MENÜNÜZÜ BUGÜN DİJİTALE TAŞIYIN</h2>
        <p class="cta-banner-desc">Restoran operasyonlarınızı kolaylaştırın, baskı maliyetlerini sıfırlayın ve müşteri deneyimini bir üst seviyeye çıkarın.</p>
        <a class="btn-hero-primary" asp-area="Restaurant" asp-controller="Auth" asp-action="Register">
            <span>Ücretsiz Kayıt Ol</span>
            <span class="material-symbols-outlined" style="font-size: 1.1rem;">arrow_forward</span>
        </a>
    </div>
</section>

@section Scripts {
<script>
(function () {
    const themes = @Html.Raw(themesJson);
    if (!themes || !themes.length) return;

    let currentIndex = 0;
    const CYCLE_DURATION = 10000; // 10 seconds
    let animFrameId = null;
    let cycleStartTime = null;
    let isPaused = false;
    let isHoverPaused = false;

    // Elements
    const iframe = document.getElementById('showcaseIframe');
    const iframeLoader = document.getElementById('showcaseIframeLoader');
    const activeEmoji = document.getElementById('activeThemeEmoji');
    const activeName = document.getElementById('activeThemeName');
    const activeDesc = document.getElementById('activeThemeDesc');
    const activeTag = document.getElementById('activeThemeTag');
    const activeCounter = document.getElementById('activeThemeCounter');
    const activeCardGlowBar = document.getElementById('activeCardGlowBar');
    const playPauseBtn = document.getElementById('themePlayPauseBtn');
    const playPauseIcon = document.getElementById('themePlayPauseIcon');
    const previewLinkBtn = document.getElementById('themePreviewLinkBtn');
    const ambientGlow = document.getElementById('phoneAmbientGlow');
    const phoneStage = document.getElementById('showcasePhoneStage');
    const pills = document.querySelectorAll('.theme-pill-item');
    const dots = document.querySelectorAll('.theme-dot-item');
    const cards = document.querySelectorAll('.theme-mini-card');

    function renderTheme(index, isManual = false) {
        currentIndex = (index + themes.length) % themes.length;
        const theme = themes[currentIndex];

        // 1. Update Phone Iframe
        if (iframe) {
            iframe.style.opacity = '0.35';
            if (iframeLoader) iframeLoader.classList.add('active');
            iframe.src = '/Home/Demo?themeId=' + theme.Id + '&embed=1';
        }

        // 2. Update Active Card Texts & Badges
        if (activeEmoji) activeEmoji.textContent = theme.Emoji;
        if (activeName) activeName.textContent = theme.Name;
        if (activeDesc) activeDesc.textContent = theme.Desc;
        if (activeTag) {
            activeTag.textContent = theme.Name;
            activeTag.style.borderColor = theme.Border;
            activeTag.style.color = theme.Accent;
            activeTag.style.backgroundColor = theme.Shadow;
        }
        if (activeCounter) activeCounter.textContent = `${currentIndex + 1} / ${themes.length}`;
        if (activeCardGlowBar) activeCardGlowBar.style.background = theme.Accent;
        if (previewLinkBtn) previewLinkBtn.href = '/Home/Preview?themeId=' + theme.Id;

        // 3. Update Dynamic Ambient Backlight Glow
        if (ambientGlow) {
            ambientGlow.style.background = `radial-gradient(circle at 50% 50%, ${theme.Shadow.replace('0.15', '0.35')} 0%, rgba(248, 249, 250, 0) 72%)`;
        }

        // 4. Update Quick Pills List
        pills.forEach((pill, i) => {
            const isActive = i === currentIndex;
            pill.classList.toggle('active', isActive);
            if (isActive) {
                pill.style.borderColor = theme.Accent;
                pill.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
            } else {
                pill.style.borderColor = '';
            }
        });

        // 5. Update Dots
        dots.forEach((dot, i) => {
            const isActive = i === currentIndex;
            dot.classList.toggle('active', isActive);
            if (isActive) {
                dot.style.backgroundColor = theme.Accent;
            } else {
                dot.style.backgroundColor = '';
            }
        });

        // 6. Update Bottom Grid Cards
        cards.forEach((card, i) => {
            card.classList.toggle('active', i === currentIndex);
        });

        // 7. Restart 10s Timer
        startProgressCycle();
    }

    function startProgressCycle() {
        cancelAnimationFrame(animFrameId);

        if (isPaused || isHoverPaused) return;

        cycleStartTime = performance.now();

        function step(timestamp) {
            if (isPaused || isHoverPaused) return;

            const elapsed = timestamp - cycleStartTime;
            if (elapsed >= CYCLE_DURATION) {
                // Auto switch to next theme after 10 seconds
                renderTheme(currentIndex + 1, false);
            } else {
                animFrameId = requestAnimationFrame(step);
            }
        }

        animFrameId = requestAnimationFrame(step);
    }

    // Iframe load complete
    if (iframe) {
        iframe.addEventListener('load', function () {
            iframe.style.opacity = '1';
            if (iframeLoader) iframeLoader.classList.remove('active');
        });
    }

    // Public window functions for clicks
    window.prevThemeShowcase = function () {
        renderTheme(currentIndex - 1, true);
    };

    window.nextThemeShowcase = function () {
        renderTheme(currentIndex + 1, true);
    };

    window.selectThemeShowcase = function (index) {
        renderTheme(index, true);
    };

    window.selectThemeAndScroll = function (index) {
        renderTheme(index, true);
        const stage = document.getElementById('demo');
        if (stage) {
            stage.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    };

    window.toggleThemePlayPause = function () {
        isPaused = !isPaused;
        if (playPauseIcon) {
            playPauseIcon.textContent = isPaused ? 'play_arrow' : 'pause';
        }
        if (playPauseBtn) {
            playPauseBtn.title = isPaused ? 'Otomatik Akışı Başlat' : 'Otomatik Akışı Duraklat';
        }
        if (!isPaused) {
            startProgressCycle();
        } else {
            cancelAnimationFrame(animFrameId);
        }
    };

    // Pause on Hover over Phone
    if (phoneStage) {
        phoneStage.addEventListener('mouseenter', function () {
            isHoverPaused = true;
            cancelAnimationFrame(animFrameId);
        });

        phoneStage.addEventListener('mouseleave', function () {
            isHoverPaused = false;
            if (!isPaused) startProgressCycle();
        });
    }

    // Keyboard Arrow Keys
    document.addEventListener('keydown', function (e) {
        const demoSection = document.getElementById('demo');
        if (!demoSection) return;
        const rect = demoSection.getBoundingClientRect();
        const isInView = rect.top < window.innerHeight && rect.bottom > 0;
        if (isInView) {
            if (e.key === 'ArrowRight') {
                nextThemeShowcase();
            } else if (e.key === 'ArrowLeft') {
                prevThemeShowcase();
            }
        }
    });

    // Touch Swipe on Phone
    let touchStartX = 0;
    let touchEndX = 0;
    if (phoneStage) {
        phoneStage.addEventListener('touchstart', function (e) {
            touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });
        phoneStage.addEventListener('touchend', function (e) {
            touchEndX = e.changedTouches[0].screenX;
            if (touchStartX - touchEndX > 50) {
                nextThemeShowcase();
            } else if (touchEndX - touchStartX > 50) {
                prevThemeShowcase();
            }
        }, { passive: true });
    }

    // Initial Start
    renderTheme(0, true);
})();
</script>
}

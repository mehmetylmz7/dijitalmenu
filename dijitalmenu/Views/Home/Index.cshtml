        new { Name = "Pastel Günbatımı",            Emoji = "🌇",  Desc = "Yumuşak şeftali ve günbatımı renkleri, yuvarlatılmış geniş köşeler.", Accent = "#ff793f", Border = "rgba(255,121,63,.35)", Shadow = "rgba(255,121,63,.15)"},
        new { Name = "Bento Düzeni",                Emoji = "🍱",  Desc = "Bento kutusu şeklinde modern parçalı grid yerleşimi ve adres kartı.", Accent = "#b45309", Border = "rgba(180,83,9,.35)", Shadow = "rgba(180,83,9,.15)"},
        new { Name = "Ege Rüzgarı",                 Emoji = "⚓",  Desc = "Mavi ve beyaz Akdeniz rüzgarı, deniz ürünleri için harika marin.", Accent = "#0284c7", Border = "rgba(2,132,199,.35)", Shadow = "rgba(2,132,199,.15)"},
        new { Name = "Fütüristik Neon Diner",       Emoji = "👾",  Desc = "Siberpunk neon renkleri, terminal kod yazı tipleri, sistem uyarıları.", Accent = "#00f0ff", Border = "rgba(0,240,255,.35)", Shadow = "rgba(0,240,255,.15)"},
        new { Name = "Sıcak Odun Ateşi",            Emoji = "🔥",  Desc = "Toprak tonlarında sıcak fırın, odun ateşi logolu şömine konsepti.", Accent = "#c0603d", Border = "rgba(192,96,61,.35)", Shadow = "rgba(192,96,61,.15)"},
        new { Name = "Lüks Akşam Yemeği",           Emoji = "🍷",  Desc = "Sinematik karanlık arka plan, altın yıldızlı premium şef yemekleri.", Accent = "#f59e0b", Border = "rgba(245,158,11,.35)", Shadow = "rgba(245,158,11,.15)"},
        new { Name = "Endüstriyel Minimalist",      Emoji = "🛠️",  Desc = "Neobrutalist kalın siyah çizgiler, gölgeli kutular ve sade düzen.", Accent = "#111827", Border = "rgba(17,24,39,.35)", Shadow = "rgba(17,24,39,.15)"},

@{
    var restaurant = ViewBag.Restaurant as EntityLayer.Concrete.Restaurant;
    var categories = ViewBag.Categories as List<EntityLayer.Concrete.Category> ?? new();
    var menuItems  = ViewBag.MenuItems  as List<EntityLayer.Concrete.MenuItem>  ?? new();

    var foodImages = new[]
    {
        "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&q=80&w=300",
        "https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&q=80&w=300",
        "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&q=80&w=300",
        "https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&fit=crop&q=80&w=300",
    };
}

<div class="bg-[#022312] text-[#e6f4ea] min-h-screen font-serif selection:bg-[#d4af37] selection:text-black">
  <!-- Zen Centered Header -->
  <header class="relative pt-24 pb-20 px-6 text-center border-b border-[#1b4332]">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(212,175,55,0.05),transparent_60%)]"></div>
    <div class="max-w-2xl mx-auto relative z-10">
      <div class="w-12 h-12 border-2 border-[#d4af37]/30 rounded-full flex items-center justify-center mx-auto mb-6 text-[#d4af37]">
        <i class="fa-solid fa-seedling animate-pulse"></i>
      </div>
      <h1 class="text-4xl md:text-5xl font-serif text-[#d4af37] uppercase tracking-[0.2em] font-medium">
        @restaurant?.Name
      </h1>
      <div class="h-[1px] w-32 bg-[#d4af37]/40 mx-auto my-4"></div>
      <p class="text-emerald-300 text-xs uppercase tracking-[0.4em] font-sans font-semibold">
        Uzak Doğu &amp; Doğu Lezzet Köprüsü
      </p>
    </div>
  </header>

  <!-- Serene Navigation Bar -->
  <nav class="sticky top-0 z-30 bg-[#022312]/95 backdrop-blur-md border-b border-[#1b4332] overflow-x-auto no-scrollbar">
    <div class="max-w-4xl mx-auto flex justify-start md:justify-center py-4 px-6 gap-6 md:gap-10 min-w-max font-sans text-xs uppercase tracking-widest text-emerald-300">
      @foreach (var cat in categories)
      {
        <button onclick="scrollToJadeCategory(this, 'jade-cat-@cat.Id')"
                class="hover:text-[#d4af37] transition-colors relative py-1 bg-transparent border-none cursor-pointer">
          @cat.Name
        </button>
      }
    </div>
  </nav>

  <!-- Content -->
  <main class="max-w-4xl mx-auto px-6 py-16">
    @foreach (var cat in categories)
    {
      var items = menuItems.Where(i => i.CategoryId == cat.Id).ToList();
      if (!items.Any()) continue;

      <section id="jade-cat-@cat.Id" class="mb-24 scroll-mt-24">
        @if (!string.IsNullOrEmpty(cat.ImageUrl))
        {
          <div class="mb-12 relative h-40 md:h-56 rounded-2xl overflow-hidden border border-[#1b4332] shadow-lg flex items-center justify-center">
            <img src="@cat.ImageUrl" alt="@cat.Name" class="absolute inset-0 w-full h-full object-cover opacity-60" />
            <div class="absolute inset-0 bg-[#022312]/50 mix-blend-multiply"></div>
            <div class="relative z-10 text-center">
              <span class="text-[#d4af37] text-xs font-sans font-bold uppercase tracking-[0.3em] block mb-2 drop-shadow-md">
                HAZIRLANIŞI ÖZEL
              </span>
              <h3 class="text-3xl md:text-4xl font-serif text-white tracking-widest drop-shadow-lg">
                @cat.Name
              </h3>
            </div>
          </div>
        }
        else
        {
          <div class="text-center mb-12">
            <span class="text-[#d4af37] text-xs font-sans font-bold uppercase tracking-[0.3em] block mb-2">
              HAZIRLANIŞI ÖZEL
            </span>
            <h3 class="text-2xl md:text-3xl font-serif text-white tracking-wide">
              @cat.Name
            </h3>
            <div class="h-[1.5px] w-12 bg-emerald-500/30 mx-auto mt-4"></div>
          </div>
        }

        <div class="space-y-12">
          @foreach (var item in items)
          {
            var img = !string.IsNullOrWhiteSpace(item.ImageUrl) ? item.ImageUrl : foodImages[item.Id % foodImages.Length];
            <div class="flex flex-col md:flex-row gap-6 p-4 rounded-xl border border-transparent hover:border-[#1b4332] hover:bg-[#042f1a]/30 transition-all duration-300">
              <div class="w-full md:w-36 h-36 shrink-0 rounded-lg overflow-hidden border border-[#1b4332] bg-[#022312]">
                <img src="@img" 
                     alt="@item.Name" 
                     class="w-full h-full object-cover opacity-80" />
              </div>
              <div class="flex-1 flex flex-col justify-between">
                <div>
                  <div class="flex justify-between items-baseline gap-4 mb-2">
                    <h4 class="text-xl font-bold text-white tracking-wide">
                      @item.Name
                    </h4>
                    <span class="font-sans text-base font-bold text-[#d4af37]">
                      @item.Price.ToString("N0") ₺
                    </span>
                  </div>
                  <p class="text-stone-300 text-sm font-sans font-light leading-relaxed">
                    @(string.IsNullOrWhiteSpace(item.Description) ? "Uzak doğu baharatları ve taze aromalarla bezenmiş tescilli reçetemiz." : item.Description)
                  </p>
                </div>
                @if (item.Price > 400)
                {
                  <div class="mt-3">
                    <span class="font-sans text-[9px] uppercase tracking-widest text-[#d4af37] border border-[#d4af37]/30 px-2.5 py-0.5 rounded">
                      Tavsiye Edilen Reçete
                    </span>
                  </div>
                }
              </div>
            </div>
          }
        </div>
      </section>
    }

    <!-- Notes -->
    <div class="border border-[#1b4332] p-8 md:p-12 bg-[#042f1a]/50 rounded-2xl relative max-w-2xl mx-auto text-center mt-20">
      <span class="font-sans text-[10px] uppercase tracking-[0.3em] text-[#d4af37] block mb-3">
        BİLGİLENDİRME
      </span>
      <p class="text-xl md:text-2xl font-serif text-[#e6f4ea] leading-relaxed mb-4">
        "Kendi alkolünü yanında getiren misafirlerimizden kişi başı <span class="text-[#d4af37] font-bold">100 TL</span> servis ücreti alınmaktadır."
      </p>
      <p class="font-sans text-[10px] italic text-stone-500">
        * Menü fiyatlarımız ve içeriklerimiz taze hammaddelere göre güncellenebilmektedir.
      </p>
    </div>
  </main>

  <!-- Serene Footer -->
  <footer class="border-t border-[#1b4332] bg-[#01140a] text-stone-500 py-16 px-6 font-sans text-xs">
    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-12 mb-12 text-center md:text-left">
      <div>
        <h5 class="text-[#d4af37] font-serif text-lg mb-4">@restaurant?.Name Meclisi</h5>
        <p class="font-light text-stone-600 leading-relaxed">
          Anadolu ve doğu mutfaklarından süzülen geleneksel lezzetleri şükranla masanıza sunuyoruz.
        </p>
      </div>
      <div>
        <h5 class="text-white font-bold uppercase tracking-widest mb-4">MÜRACAAT</h5>
        <p>Telefon: @(string.IsNullOrWhiteSpace(restaurant?.Phone) ? "+90 555 000 00 00" : restaurant.Phone)</p>
        <p class="mt-2 text-stone-500">📍 @(string.IsNullOrWhiteSpace(restaurant?.Address) ? "Atatürk Caddesi, Hatay" : restaurant.Address)</p>
      </div>
      <div>
        <h5 class="text-white font-bold uppercase tracking-widest mb-4">ÇALIŞMA GÜNLERİ</h5>
        <p>Hafta İçi: 11:00 - 23:00</p>
        <p>Hafta Sonu: 10:00 - 00:00</p>
      </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(restaurant?.GoogleMapsUrl))
    {
      var mapsUrl = restaurant.GoogleMapsUrl;
      <div class="max-w-4xl mx-auto my-8 overflow-hidden rounded-2xl border border-[#1b4332] shadow-xl">
        @if (mapsUrl.Contains("embed"))
        {
          <iframe src="@mapsUrl" class="w-full h-64 border-0" allowfullscreen="" loading="lazy"></iframe>
        }
        else
        {
          <div class="p-6 text-center bg-[#05291b]">
            <a href="@mapsUrl" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-3 bg-[#d4af37] hover:bg-[#b59228] text-[#01140a] font-bold rounded-xl text-xs uppercase tracking-wider transition-all shadow-md">
              <i class="fa-solid fa-location-dot"></i> Haritada Gör &amp; Yol Tarifi Al
            </a>
          </div>
        }
      </div>
    }
  </footer>
</div>

<script>
function scrollToJadeCategory(btn, catId) {
  if (btn) {
    btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
  }
  const element = document.getElementById(catId);
  if (element) {
    element.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
}
</script>

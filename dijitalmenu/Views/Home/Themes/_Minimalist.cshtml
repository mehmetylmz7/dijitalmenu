@{
    var restaurant = ViewBag.Restaurant as EntityLayer.Concrete.Restaurant;
    var categories = ViewBag.Categories as List<EntityLayer.Concrete.Category>;
    var menuItems = ViewBag.MenuItems as List<EntityLayer.Concrete.MenuItem>;
}

<div class="bg-white min-h-screen py-20 px-8 flex flex-col items-center font-sans">
    <!-- Header -->
    <header class="mb-24 text-center max-w-2xl w-full">
        <h1 class="text-5xl font-extralight tracking-[0.2em] uppercase mb-4 text-zinc-900 leading-tight">
            @restaurant?.Name
        </h1>
        <div class="h-px w-20 bg-zinc-200 mx-auto mb-6"></div>
        <p class="text-zinc-500 font-light tracking-widest text-sm uppercase italic">
            Geleneksel Lezzetlerin Modern Buluşma Noktası
        </p>
    </header>

    <!-- Categories and Items -->
    <div class="w-full max-w-4xl space-y-24">
        @foreach (var category in categories)
        {
            var catItems = menuItems?.Where(mi => mi.CategoryId == category.Id).ToList() ?? new List<EntityLayer.Concrete.MenuItem>();
            
            <section class="relative">
                <h2 class="text-xs font-semibold tracking-[0.4em] uppercase text-zinc-400 mb-12 flex items-center gap-4">
                    <span class="shrink-0">@category.Name</span>
                    <div class="h-px w-full bg-zinc-100"></div>
                </h2>
                
                <div class="grid md:grid-cols-2 gap-x-20 gap-y-16">
                    @foreach (var item in catItems)
                    {
                        var imgIndex = item.Id % 5;
                        var imageUrl = imgIndex == 0 ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&q=80&w=300" :
                                       imgIndex == 1 ? "https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&q=80&w=300" :
                                       imgIndex == 2 ? "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&q=80&w=300" :
                                       imgIndex == 3 ? "https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&fit=crop&q=80&w=300" :
                                                       "https://images.unsplash.com/photo-1482049016688-2d3e1b311543?auto=format&fit=crop&q=80&w=300";

                        <div class="group cursor-default flex gap-6">
                            <div class="w-24 h-24 shrink-0 overflow-hidden bg-zinc-50 border border-zinc-100 rounded-sm">
                                <img src="@imageUrl" alt="@item.Name" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                            </div>
                            <div class="flex-1">
                                <div class="flex justify-between items-baseline mb-2">
                                    <h3 class="text-zinc-800 font-medium tracking-wide group-hover:text-zinc-400 transition-colors">
                                        @item.Name
                                    </h3>
                                    <span class="text-zinc-400 text-sm font-light italic ml-4 shrink-0">
                                        @item.Price.ToString("N0") TL
                                    </span>
                                </div>
                                <p class="text-zinc-400 text-sm font-light leading-relaxed">
                                    @(string.IsNullOrWhiteSpace(item.Description) ? "Bu yemek için açıklama belirtilmemiş." : item.Description)
                                </p>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
    </div>

    <!-- Footer -->
    <footer class="mt-40 pt-20 border-t border-zinc-100 w-full max-w-4xl text-center text-zinc-400 text-xs tracking-widest uppercase font-light space-y-2">
        <p>Merkez Mahallesi, Gastronomi Sokak No: 7</p>
        <p>+90 (212) 555 01 23 • 11:00 - 23:00</p>
    </footer>
</div>

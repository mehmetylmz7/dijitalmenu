@{
    var restaurant = ViewBag.Restaurant as EntityLayer.Concrete.Restaurant;
    var categories = ViewBag.Categories as List<EntityLayer.Concrete.Category> ?? new();
    var menuItems  = ViewBag.MenuItems  as List<EntityLayer.Concrete.MenuItem>  ?? new();

    // Default category images matching the prompt's aesthetic
    var defaultCategoryImages = new[]
    {
        "https://lh3.googleusercontent.com/aida-public/AB6AXuCqdlUE5teJERHHQnVQ4pGyrfnMwEZMzmWHrMRjTl9dZ7UQrn2GE5U6_xO6993vBqH6FmLGi8X2844bT0JkHjIomkRLN2H2P2mG0mYfPoUPyBONH0bXCrmhkGMsfQpbQpgL1BKHFzyDavffgUjUp1CP1oE_0u-ef7zTlBtyYbnzsMG_zBlsLaWlKBGBmoKH32ZMY0mX4daFvH-_ArfkYhxiViPRZY8hGMXQI4ro8lMUDbteNc9RmpH4",
        "https://lh3.googleusercontent.com/aida-public/AB6AXuBRqjggfFf_SRGzwizUrltFNhT-QiurzGoIpIBAsw88ZTAeOsUS34hRZmaFD1mQNrAbDBLnY6ncRqe5DHpIk4aFpkIwKS8b8cO7CQvw3x7DerkTjnLG1xDtb2u3MqfX36ppzzAHsUv5jzDTgmY1zLetuCy0MT-8BP8ac1MG4mvl3BUnw1oVRrY4AMLWR3Q99xBeZZhF-z53ih49ZtXyTvCt1KXTqWwsp2Wq5XfH-NMf3WpKq0-aupZB",
        "https://lh3.googleusercontent.com/aida-public/AB6AXuA6-HdXn7OZ4jgqdRFhaz9ZQOjS5EbYp7wcVXvAFHkWpGCquQyAGG1ujfdwYGg6hQCDssH4Ca1nMPHZH_CobI4bWqWODZSvlu-kIl8A0huProijs2etcwy-7IWwiZ-q_q3sFewqQZrnGHctbfGx1g-4XlvKMHt0_OZZFNGa4EfZbW4MytNQ65poQ1dXikO6QmDEgL-J1VQX5VBvQvM8iYd70EHu67vF2YoBk63ePLJIAlNys9pbQh1w",
        "https://lh3.googleusercontent.com/aida-public/AB6AXuD0-84CJ61FHb8ZP3dGMoyEWSGhopoQKUEwrC4TWm4YSsdoR5Cge5ebOxg4Ab4Fz_r3UcpTr74M-gsnzgTYaBsmvOjzwB8n53tQ4B6AUDMAcUmJRpCkrV1Gprqx_V6HRJsMgt6e9LDU9YoZ-olRyeDZPzn2uhMdY5JwqZhz2e39A7-_4UZ4M2QqzrpBdk2kZzUZDOHYX3pxeRhqBlg9rjaw2VduKb0wYvHV8pP79nzsbF2AXmD30ny0",
        "https://lh3.googleusercontent.com/aida-public/AB6AXuA98TAAVp-t7ZzFKBUEvJcwmTMZK7xZl0rfk6WLzn0SmxjmhJtJwmLB8G1fwznANCFQensv3Tp8hfdnt_AfyZUZCM2N4JDVTMimodHu1edRwp6r-wYW30ukRBBG0dIE0_Ss4bbLEE8oaNZhMQV1WrM4fp3KQlxR3wDWNuTzMsNEZSdSVkqjYzeBt0sDkIwC7BfYsX8QTeLWoFE7Bk2PuKlr45YoM6vRL0NiC7vFQv2tRYBqpccSBveS",
        "https://images.unsplash.com/photo-1541544741938-0af808871cc0?auto=format&fit=crop&q=80&w=800"
    };

    // Default item images
    var defaultItemImages = new[]
    {
        "https://lh3.googleusercontent.com/aida-public/AB6AXuDT-Z2SOdhldBbbDdW8DaucEAk9VT99iZCNYVUJFRJs0FvLCQ9X-Ji8uchzqdynsrmNb3yub6PJU8Y2rju5bnn7cZlUuRI2IdDX-7Rcjttyr-dXQ0VddEhaA61PVYcl8BXd2XkPqJGoOonhB-lko_sAC0MjAEdhpNA7GpCqlvPINCjHrKUk6y3VxmbqOOq5PX-8SdBonAVo3OFHnwvOH7b6z8enI_MOztb1vqgjWqiQlQNeFsc-LrFe",
        "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&q=80&w=600",
        "https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&q=80&w=600",
        "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&q=80&w=600",
        "https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&fit=crop&q=80&w=600",
        "https://images.unsplash.com/photo-1540420773420-3366772f4999?auto=format&fit=crop&q=80&w=600"
    };

    // Generate 2-1-2-1 Asymmetrical category groups
    var catRows = new List<(List<EntityLayer.Concrete.Category> Cats, bool IsSingle)>();
    int catIdx = 0;
    bool takeTwo = true;
    while (catIdx < categories.Count)
    {
        if (takeTwo)
        {
            var countToTake = Math.Min(2, categories.Count - catIdx);
            catRows.Add((categories.Skip(catIdx).Take(countToTake).ToList(), false));
            catIdx += countToTake;
            takeTwo = false;
        }
        else
        {
            catRows.Add((categories.Skip(catIdx).Take(1).ToList(), true));
            catIdx += 1;
            takeTwo = true;
        }
    }

    int globalItemCounter = 0;
}

<!-- Google Fonts & Material Symbols -->
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style>
    .asym-theme {
        --color-primary: #006c49;
        --color-primary-container: #10b981;
        --color-on-primary-container: #00422b;
        --color-surface: #f8f9fa;
        --color-on-surface: #191c1d;
        --color-surface-low: #f3f4f5;
        --color-surface-container: #edeeef;
        --color-surface-highest: #e1e3e4;
        --color-secondary: #575e70;
        --color-outline-variant: #bbcabf;
        background-color: var(--color-surface);
        color: var(--color-on-surface);
        font-family: 'Inter', system-ui, sans-serif;
        -webkit-tap-highlight-color: transparent;
    }

    .asym-theme .font-sora {
        font-family: 'Sora', sans-serif;
    }

    .asym-theme .category-overlay {
        background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.2) 60%, rgba(0,0,0,0) 100%);
    }

    .asym-theme .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .asym-theme .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .asym-tab-active {
        background-color: #10b981 !important;
        color: #00422b !important;
        font-weight: 700 !important;
        box-shadow: 0 2px 8px rgba(16, 185, 129, 0.25);
    }
</style>

<div class="asym-theme min-h-screen antialiased selection:bg-[#10b981] selection:text-white pb-20">

    <!-- TopNavBar (Fixed Header) -->
    <header class="fixed top-0 w-full z-50 bg-[#f8f9fa]/90 backdrop-blur-md border-b border-[#bbcabf]/30 shadow-sm flex justify-between items-center px-4 md:px-10 h-20">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-[#006c49] text-white flex items-center justify-center font-bold text-lg shadow-sm shrink-0">
                <span class="material-symbols-outlined text-2xl">restaurant_menu</span>
            </div>
            <div>
                <div class="text-lg sm:text-2xl font-sora font-bold text-[#191c1d] tracking-tight leading-tight">
                    @(restaurant?.Name ?? "Dijital Menü")
                </div>
                <p class="text-[11px] sm:text-xs text-[#575e70] font-medium hidden sm:block">
                    @(string.IsNullOrWhiteSpace(restaurant?.Address) ? "Lezzetin Dijital Adresi" : restaurant.Address)
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <button onclick="toggleAsymSearch()" 
                    aria-label="Arama" 
                    class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-white border border-[#bbcabf]/40 text-[#191c1d] hover:text-[#006c49] hover:border-[#006c49]/50 flex items-center justify-center transition-all duration-200 focus:outline-none shadow-sm cursor-pointer">
                <span class="material-symbols-outlined text-2xl">search</span>
            </button>
        </div>
    </header>

    <!-- Search Dropdown Bar (Collapsible Live Filter) -->
    <div id="asymSearchBar" class="hidden fixed top-20 left-0 w-full z-40 bg-white/95 backdrop-blur-md border-b border-[#bbcabf]/40 px-4 py-3 shadow-md transition-all">
        <div class="max-w-xl mx-auto relative flex items-center">
            <span class="material-symbols-outlined absolute left-3.5 text-[#575e70] text-xl">search</span>
            <input id="asymSearchInput" 
                   type="text" 
                   placeholder="Menüde lezzet veya içecek ara..." 
                   oninput="filterAsymMenuItems(this.value)" 
                   class="w-full pl-11 pr-10 py-2.5 rounded-full bg-[#f3f4f5] border border-[#bbcabf]/40 text-sm focus:outline-none focus:border-[#006c49] text-[#191c1d]" />
            <button onclick="clearAsymSearch()" class="absolute right-3.5 text-[#575e70] hover:text-[#191c1d] cursor-pointer">
                <span class="material-symbols-outlined text-lg">close</span>
            </button>
        </div>
    </div>

    <!-- Main Content Area -->
    <main class="pt-[100px] px-4 max-w-[640px] mx-auto md:max-w-6xl md:px-10 md:pt-[120px]">

        <!-- Horizontal Scrolling Category Tabs -->
        @if (categories.Any())
        {
            <nav class="sticky top-[80px] z-30 bg-[#f8f9fa]/95 backdrop-blur-md py-2.5 mb-6 -mx-4 px-4 overflow-x-auto no-scrollbar flex gap-2 border-b border-[#bbcabf]/20">
                @for (int i = 0; i < categories.Count; i++)
                {
                    var cat = categories[i];
                    <button id="asym-tab-btn-@cat.Id" 
                            class="asym-category-tab whitespace-nowrap px-4 py-2 rounded-full text-xs sm:text-sm font-semibold transition-all cursor-pointer @(i == 0 ? "asym-tab-active" : "bg-[#edeeef] text-[#191c1d] hover:bg-[#e1e3e4]")" 
                            onclick="scrollToAsymSection('asym-cat-@cat.Id', this)">
                        @cat.Name
                    </button>
                }
            </nav>
        }

        <!-- Service / Important Notice Alert Box -->
        @if (!string.IsNullOrWhiteSpace(restaurant?.ImportantNotice) || restaurant?.Id == 0)
        {
            var notice = !string.IsNullOrWhiteSpace(restaurant?.ImportantNotice)
                ? restaurant.ImportantNotice
                : "Menü fiyatlarımıza KDV dahildir. Tüm yemeklerimiz günlük taze malzemeler ve mevsimlik ürünlerle usta şeflerimiz tarafından özenle hazırlanmaktadır.";

            <div class="mb-8 bg-white border border-[#bbcabf]/40 rounded-2xl p-4 sm:p-5 flex items-start gap-3.5 shadow-sm relative overflow-hidden">
                <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-[#006c49] rounded-l-2xl"></div>
                <div class="w-9 h-9 rounded-xl bg-[#006c49]/10 text-[#006c49] flex items-center justify-center shrink-0 mt-0.5">
                    <span class="material-symbols-outlined text-xl">info</span>
                </div>
                <div class="min-w-0 flex-1">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-[#006c49] mb-0.5">Önemli Bilgilendirme</h4>
                    <p class="text-xs sm:text-sm text-[#575e70] leading-relaxed">
                        @notice
                    </p>
                </div>
            </div>
        }

        <!-- Asymmetrical Category Grid (2-1-2-1) -->
        @if (categories.Any())
        {
            <section class="mb-10" id="category-grid">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="font-sora text-xl sm:text-2xl font-bold text-[#191c1d] tracking-tight">Kategoriler</h2>
                    <span class="text-xs font-semibold text-[#575e70]">@categories.Count Kategori</span>
                </div>

                <div class="flex flex-col gap-2.5 sm:gap-4">
                    @for (int rIdx = 0; rIdx < catRows.Count; rIdx++)
                    {
                        var row = catRows[rIdx];
                        if (!row.IsSingle)
                        {
                            <!-- Row: 2 Cards -->
                            <div class="grid grid-cols-2 gap-2.5 sm:gap-4">
                                @foreach (var cat in row.Cats)
                                {
                                    var catImg = !string.IsNullOrWhiteSpace(cat.ImageUrl) 
                                        ? cat.ImageUrl 
                                        : defaultCategoryImages[cat.Id % defaultCategoryImages.Length];

                                    <div class="relative h-36 sm:h-44 rounded-2xl overflow-hidden cursor-pointer group shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-0.5" 
                                         onclick="scrollToAsymSection('asym-cat-@cat.Id')">
                                        <img alt="@cat.Name" 
                                             class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                                             src="@catImg" 
                                             loading="lazy" />
                                        <div class="absolute inset-0 category-overlay"></div>
                                        <div class="absolute bottom-3.5 left-3.5 sm:bottom-4 sm:left-4 right-3">
                                            <span class="font-sora text-base sm:text-xl text-white font-bold tracking-tight line-clamp-1">
                                                @cat.Name
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <!-- Row: 1 Large Card -->
                            <div class="grid grid-cols-1">
                                @foreach (var cat in row.Cats)
                                {
                                    var catImg = !string.IsNullOrWhiteSpace(cat.ImageUrl) 
                                        ? cat.ImageUrl 
                                        : defaultCategoryImages[cat.Id % defaultCategoryImages.Length];

                                    <div class="relative h-44 sm:h-52 rounded-2xl overflow-hidden cursor-pointer group shadow-sm hover:shadow-md transition-all duration-300 transform hover:-translate-y-0.5" 
                                         onclick="scrollToAsymSection('asym-cat-@cat.Id')">
                                        <img alt="@cat.Name" 
                                             class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                                             src="@catImg" 
                                             loading="lazy" />
                                        <div class="absolute inset-0 category-overlay"></div>
                                        <div class="absolute bottom-4 left-4 sm:bottom-5 sm:left-6 right-4">
                                            <span class="font-sora text-xl sm:text-2xl md:text-3xl text-white font-bold tracking-tight">
                                                @cat.Name
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </section>
        }

        <!-- Menu Items List -->
        <div class="flex flex-col gap-10" id="asym-menu-lists">
            @if (!categories.Any())
            {
                <div class="bg-white border border-[#bbcabf]/40 rounded-3xl p-12 text-center shadow-sm my-6">
                    <span class="text-5xl block mb-4">🌿</span>
                    <h3 class="font-sora text-lg font-bold text-[#191c1d] mb-2">Henüz menü eklenmemiş</h3>
                    <p class="text-sm text-[#575e70]">Restoran panelinden kategori ve ürünler ekleyebilirsiniz.</p>
                </div>
            }

            @foreach (var category in categories)
            {
                var catItems = menuItems.Where(mi => mi.CategoryId == category.Id).ToList();
                if (!catItems.Any()) continue;

                <section class="scroll-mt-[150px] asym-cat-section" id="asym-cat-@category.Id" data-cat-id="@category.Id">
                    <div class="flex items-center justify-between pb-2.5 mb-4 border-b border-[#bbcabf]/30">
                        <h3 class="font-sora text-xl sm:text-2xl font-bold text-[#191c1d] tracking-tight">
                            @category.Name
                        </h3>
                        <span class="text-xs font-semibold text-[#575e70] bg-[#edeeef] px-3 py-1 rounded-full">
                            @catItems.Count Çeşit
                        </span>
                    </div>

                    <div class="flex flex-col gap-3 sm:gap-4">
                        @for (int i = 0; i < catItems.Count; i++)
                        {
                            var item = catItems[i];
                            globalItemCounter++;

                            var itemImg = !string.IsNullOrWhiteSpace(item.ImageUrl) 
                                ? item.ImageUrl 
                                : defaultItemImages[globalItemCounter % defaultItemImages.Length];

                            <article class="asym-item-card flex bg-white rounded-2xl overflow-hidden border border-[#bbcabf]/30 shadow-sm hover:shadow-md hover:border-[#006c49]/40 transition-all duration-300 group" 
                                     data-title="@item.Name.ToLower()" 
                                     data-desc="@(item.Description?.ToLower() ?? "")">
                                
                                <!-- Image Container (1/3) -->
                                <div class="w-1/3 sm:w-40 shrink-0 relative overflow-hidden bg-[#f3f4f5]">
                                    <img alt="@item.Name" 
                                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                                         src="@itemImg" 
                                         loading="lazy" />
                                </div>

                                <!-- Content Container -->
                                <div class="p-3.5 sm:p-4 flex flex-col justify-between w-full min-w-0">
                                    <div>
                                        <div class="flex justify-between items-start gap-2 mb-1">
                                            <h4 class="font-sora text-sm sm:text-base font-bold text-[#191c1d] group-hover:text-[#006c49] transition-colors leading-snug">
                                                @item.Name
                                            </h4>
                                            <span class="text-sm sm:text-base font-bold text-[#006c49] whitespace-nowrap shrink-0 bg-emerald-50 px-2.5 py-0.5 rounded-lg border border-emerald-100/80">
                                                @item.Price.ToString("N0") ₺
                                            </span>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <p class="text-xs text-[#575e70] line-clamp-2 leading-relaxed font-normal">
                                                @item.Description
                                            </p>
                                        }
                                    </div>

                                    <!-- Tags / Dietary Badges -->
                                    <div class="mt-3 flex flex-wrap gap-1.5 items-center">
                                        @if (globalItemCounter % 3 == 0 || item.Price > 400)
                                        {
                                            <span class="bg-[#e8f5e9] text-[#006c49] text-[10px] px-2 py-0.5 rounded-full font-bold flex items-center gap-1">
                                                <span class="material-symbols-outlined text-[12px]">star</span> Şefin Tavsiyesi
                                            </span>
                                        }
                                        else if (globalItemCounter % 4 == 0)
                                        {
                                            <span class="bg-amber-50 text-amber-800 text-[10px] px-2 py-0.5 rounded-full font-bold flex items-center gap-1">
                                                <span class="material-symbols-outlined text-[12px]">local_fire_department</span> Popüler
                                            </span>
                                        }

                                        @if (globalItemCounter % 2 == 0)
                                        {
                                            <span class="bg-[#f3f4f5] text-[#3c4a42] text-[10px] px-2 py-0.5 rounded-full font-medium">Taze &amp; Günlük</span>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }

            <div id="asymNoResults" class="hidden bg-white border border-[#bbcabf]/40 rounded-3xl p-10 text-center shadow-sm my-6">
                <span class="material-symbols-outlined text-4xl text-[#575e70] mb-2">search_off</span>
                <h4 class="font-sora text-base font-bold text-[#191c1d] mb-1">Aramanızla eşleşen ürün bulunamadı</h4>
                <p class="text-xs text-[#575e70]">Lütfen farklı bir arama terimi deneyiniz.</p>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="mt-16 bg-[#f3f4f5] w-full py-12 border-t border-[#bbcabf]/40">
        <div class="max-w-6xl mx-auto px-4 md:px-10">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
                <!-- Restoran Bilgisi -->
                <div>
                    <div class="font-sora text-xl font-bold text-[#191c1d] mb-2 flex items-center gap-2">
                        <span class="material-symbols-outlined text-[#006c49]">storefront</span>
                        @(restaurant?.Name ?? "Dijital Menü")
                    </div>
                    <p class="text-xs sm:text-sm text-[#575e70] leading-relaxed">
                        Taze ve lezzetli menümüzle sizlere en iyi gastronomi deneyimini sunuyoruz.
                    </p>
                </div>

                <!-- İletişim & Saatler -->
                <div class="flex flex-col gap-2 text-xs sm:text-sm text-[#575e70]">
                    <div class="font-sora font-bold text-[#191c1d] text-sm mb-1 uppercase tracking-wider">İletişim</div>
                    @if (!string.IsNullOrWhiteSpace(restaurant?.Phone))
                    {
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-sm text-[#006c49]">call</span>
                            <a href="tel:@restaurant.Phone" class="hover:text-[#006c49] transition-colors">@restaurant.Phone</a>
                        </div>
                    }
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm text-[#006c49]">schedule</span>
                        <span>@(string.IsNullOrWhiteSpace(restaurant?.WorkingHours) ? "Hergün: 10:00 - 23:00" : restaurant.WorkingHours)</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm text-[#006c49]">location_on</span>
                        <span>@(string.IsNullOrWhiteSpace(restaurant?.Address) ? "Merkez, Türkiye" : restaurant.Address)</span>
                    </div>
                </div>

                <!-- Harita Butonu / Embed -->
                <div>
                    <div class="font-sora font-bold text-[#191c1d] text-sm mb-2 uppercase tracking-wider">Konum</div>
                    @if (!string.IsNullOrWhiteSpace(restaurant?.GoogleMapsUrl))
                    {
                        var mapsUrl = restaurant.GoogleMapsUrl;
                        <a href="@mapsUrl" 
                           target="_blank" 
                           rel="noopener" 
                           class="inline-flex items-center gap-2 bg-[#006c49] hover:bg-[#005236] text-white px-4 py-2.5 rounded-xl font-semibold text-xs transition-all shadow-sm">
                            <span class="material-symbols-outlined text-base">map</span>
                            <span>Google Haritalar'da Aç</span>
                        </a>
                    }
                    else
                    {
                        <p class="text-xs text-[#575e70]">Keyifli bir yemek deneyimi için sizleri bekliyoruz.</p>
                    }
                </div>
            </div>

            <div class="pt-6 border-t border-[#bbcabf]/30 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#575e70]">
                <p>© @DateTime.Now.Year @(restaurant?.Name ?? "Dijital Menü"). Tüm Hakları Saklıdır.</p>
                <div class="flex items-center gap-4">
                    <span class="text-[11px] text-[#575e70]">Modern Asimetrik QR Menü Çözümü</span>
                </div>
            </div>
        </div>
    </footer>
</div>

<script>
    function scrollToAsymSection(id, btnElement) {
        const element = document.getElementById(id);
        if (element) {
            element.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        if (btnElement) {
            document.querySelectorAll('.asym-category-tab').forEach(b => {
                b.classList.remove('asym-tab-active');
                b.classList.add('bg-[#edeeef]', 'text-[#191c1d]');
            });
            btnElement.classList.add('asym-tab-active');
            btnElement.classList.remove('bg-[#edeeef]', 'text-[#191c1d]');
        }
    }

    function toggleAsymSearch() {
        const bar = document.getElementById('asymSearchBar');
        const input = document.getElementById('asymSearchInput');
        if (bar.classList.contains('hidden')) {
            bar.classList.remove('hidden');
            setTimeout(() => input.focus(), 50);
        } else {
            bar.classList.add('hidden');
            clearAsymSearch();
        }
    }

    function clearAsymSearch() {
        const input = document.getElementById('asymSearchInput');
        if (input) {
            input.value = '';
            filterAsymMenuItems('');
        }
    }

    function filterAsymMenuItems(query) {
        const q = (query || '').trim().toLowerCase();
        const cards = document.querySelectorAll('.asym-item-card');
        const sections = document.querySelectorAll('.asym-cat-section');
        const noResults = document.getElementById('asymNoResults');
        let totalVisible = 0;

        cards.forEach(card => {
            const title = card.getAttribute('data-title') || '';
            const desc = card.getAttribute('data-desc') || '';
            const match = !q || title.includes(q) || desc.includes(q);
            card.style.display = match ? 'flex' : 'none';
            if (match) totalVisible++;
        });

        sections.forEach(sec => {
            const visibleInSec = sec.querySelectorAll('.asym-item-card:not([style*="display: none"])').length;
            sec.style.display = visibleInSec > 0 ? 'block' : 'none';
        });

        if (noResults) {
            noResults.classList.toggle('hidden', totalVisible > 0 || !q);
        }
    }
</script>

@{
    var restaurant = ViewBag.Restaurant as EntityLayer.Concrete.Restaurant;
    var categories = ViewBag.Categories as List<EntityLayer.Concrete.Category> ?? new();
    var menuItems  = ViewBag.MenuItems  as List<EntityLayer.Concrete.MenuItem>  ?? new();

    var foodImages = new[]
    {
        "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&q=80&w=400",
        "https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&q=80&w=400",
        "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&q=80&w=400",
        "https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&fit=crop&q=80&w=400",
    };
}

<div class="bg-[#030008] text-[#e0e0ff] min-h-screen font-mono selection:bg-[#00f0ff] selection:text-black">
  <!-- Sci-Fi Cyber Grid Header -->
  <header class="relative pt-16 pb-12 px-6 border-b border-[#00f0ff]/30 overflow-hidden bg-[linear-gradient(rgba(0,240,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(0,240,255,0.03)_1px,transparent_1px)] bg-[size:24px_24px]">
    <div class="absolute top-4 right-6 flex items-center gap-2 text-xs text-[#00f0ff]">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
      <span>SYSTEM_ONLINE // V3.0</span>
    </div>
    <div class="max-w-4xl mx-auto text-center relative z-10">
      <h1 class="text-4xl md:text-6xl font-black uppercase text-[#00f0ff] tracking-tighter drop-shadow-[0_0_12px_rgba(0,240,255,0.4)]">
        @restaurant?.Name // RESTORAN
      </h1>
      <p class="text-[#ff007f] text-xs uppercase tracking-[0.4em] font-bold mt-2 drop-shadow-[0_0_8px_rgba(255,0,127,0.4)]">
        :: GELENEKSEL_LEZZET_MATRISI ::
      </p>
    </div>
  </header>

  <!-- Cyberpunk Navigation Panel -->
  <nav class="sticky top-0 z-30 bg-[#030008]/90 backdrop-blur-md border-b border-[#00f0ff]/20 overflow-x-auto no-scrollbar">
    <div class="max-w-4xl mx-auto flex justify-center py-4 px-6 gap-6 min-w-max">
      @foreach (var cat in categories)
      {
        <button onclick="scrollToCyberCategory('cyber-cat-@cat.Id')"
                class="text-[#00f0ff]/70 hover:text-[#00f0ff] hover:bg-[#00f0ff]/10 px-4 py-2 border border-[#00f0ff]/20 hover:border-[#00f0ff] transition-all duration-300 text-xs font-bold uppercase bg-transparent cursor-pointer">
          [ @cat.Name ]
        </button>
      }
    </div>
  </nav>

  <!-- Content -->
  <main class="max-w-6xl mx-auto px-6 py-16">
    @foreach (var cat in categories)
    {
      var items = menuItems.Where(i => i.CategoryId == cat.Id).ToList();
      if (!items.Any()) continue;

      <section id="cyber-cat-@cat.Id" class="mb-24 scroll-mt-28 text-left">
        <div class="mb-10 flex items-center justify-between border-b border-[#00f0ff]/10 pb-2">
          <h3 class="text-xl md:text-2xl font-black text-[#00f0ff] tracking-tight uppercase flex items-center gap-2">
            <i class="fa-solid fa-terminal text-[#ff007f]"></i> @cat.Name
          </h3>
          <span class="text-xs text-[#00f0ff]/50">SEC_ID: @cat.Name.ToUpper()_DB</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          @foreach (var item in items)
          {
            var img = foodImages[item.Id % foodImages.Length];
            <div class="border border-[#00f0ff]/20 hover:border-[#00f0ff] bg-[#0c071a]/50 hover:bg-[#0c071a] hover:shadow-[0_0_20px_rgba(0,240,255,0.15)] transition-all duration-300 flex flex-col h-full relative group">
              <div class="relative h-56 overflow-hidden border-b border-[#00f0ff]/20">
                <img src="@img" 
                     alt="@item.Name" 
                     class="w-full h-full object-cover group-hover:scale-105 transition-all duration-500" />
                @if (item.Price > 400)
                {
                  <div class="absolute top-4 left-4 bg-[#ff007f] text-white text-[9px] uppercase font-bold tracking-widest px-3 py-1 border border-white">
                    CRITICAL_DISC
                  </div>
                }
              </div>
              <div class="p-6 flex flex-col flex-1">
                <div class="flex justify-between items-start gap-4 mb-3">
                  <h4 class="text-base font-bold text-white group-hover:text-[#00f0ff] transition-colors uppercase">
                    @item.Name
                  </h4>
                  <span class="text-base font-bold text-[#ff007f] drop-shadow-[0_0_8px_rgba(255,0,127,0.3)] shrink-0">
                    [@item.Price.ToString("N0") ₺]
                  </span>
                </div>
                <p class="text-[#a0a0cf] text-xs leading-relaxed mb-6 flex-1">
                  @(string.IsNullOrWhiteSpace(item.Description) ? "Sistem optimizasyonlu, KDV dahil enfes lezzet." : item.Description)
                </p>
                <div class="border-t border-[#00f0ff]/10 pt-4 flex justify-between text-[9px] text-[#00f0ff]/40">
                  <span>SYS_ID: 0@item.Id</span>
                  <span>STATUS: AVAILABLE</span>
                </div>
              </div>
            </div>
          }
        </div>
      </section>
    }

    <!-- Warning Section -->
    <div class="border border-[#ff007f]/40 p-8 md:p-12 bg-[#ff007f]/5 hover:bg-[#ff007f]/10 transition-all duration-300 relative text-left">
      <div class="absolute -top-3 left-6 bg-[#030008] px-3 text-[#ff007f] text-xs font-bold uppercase flex items-center gap-1.5">
        <i class="fa-solid fa-triangle-exclamation animate-pulse"></i> SYSTEM_ALERT
      </div>
      <p class="text-xl md:text-2xl font-black uppercase tracking-tight mb-4 text-[#00f0ff] leading-normal">
        "Kendi alkolünü yanında getiren misafirlerimizden kişi başı <span class="text-[#ff007f] font-bold bg-[#ff007f]/10 border border-[#ff007f]/30 px-2 py-0.5">100 TL</span> servis ücreti alınmaktadır."
      </p>
      <p class="text-[#a0a0cf] text-xs">
        &gt; TÜM FİYAT MATRİSLERİMİZ GÜNCEL KDV DAHİLDİR. DEĞİŞİKLİK GÖSTEREBİLİR.
      </p>
    </div>
  </main>

  <!-- Cyber Footer -->
  <footer class="border-t border-[#00f0ff]/20 bg-[#06040f] py-16 px-6 text-xs text-[#a0a0cf]">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-12 mb-12 text-left">
      <div>
        <h5 class="text-[#00f0ff] font-bold uppercase tracking-widest mb-4">
          // KOCAOĞLU
        </h5>
        <p class="leading-relaxed">
          Cyber-gastronomi ilkelerine dayalı geleneksel Antakya tarifleri, optimize edilmiş süreçlerle sunulur.
        </p>
      </div>
      <div>
        <h5 class="text-[#ff007f] font-bold uppercase tracking-widest mb-4">
          // DATALINK
        </h5>
        <p>TEL: +90 555 000 00 00</p>
      </div>
      <div>
        <h5 class="text-white font-bold uppercase tracking-widest mb-4">
          // TERMINAL
        </h5>
        <p>Atatürk Caddesi, No: 123</p>
        <p>Hatay, Türkiye</p>
      </div>
      <div>
        <h5 class="text-white font-bold uppercase tracking-widest mb-4">
          // HOURS
        </h5>
        <p>SEC_01: 11:00 - 23:00</p>
        <p>SEC_02: 10:00 - 00:00</p>
      </div>
    </div>
  </footer>
</div>

<script>
function scrollToCyberCategory(catId) {
  const element = document.getElementById(catId);
  if (element) {
    element.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
}
</script>

@{
    var restaurant = ViewBag.Restaurant as EntityLayer.Concrete.Restaurant;
    var categories = ViewBag.Categories as List<EntityLayer.Concrete.Category> ?? new();
    var menuItems  = ViewBag.MenuItems  as List<EntityLayer.Concrete.MenuItem>  ?? new();
}

<div class="bg-[#f4eedb] text-[#1c1813] min-h-screen font-serif p-4 md:p-8 selection:bg-[#5c4033] selection:text-white">
  <!-- Outer vintage border container -->
  <div class="max-w-5xl mx-auto border-4 border-double border-[#3e2e1e] p-6 md:p-12 bg-[#f9f5e8] shadow-md">
    <!-- Newspaper Header -->
    <header class="border-b-4 border-black pb-6 mb-10 text-center">
      <div class="flex justify-between border-b border-black/30 pb-2 mb-4 text-[11px] font-sans uppercase tracking-[0.15em] text-[#5c4033]">
        <span>SAYI: 45 // 1978'DEN BERİ</span>
        <span>FİYAT: LOKAL LEZZET</span>
        <span>@restaurant?.Name HİZMETİDİR</span>
      </div>
      <h1 class="text-5xl md:text-7xl font-serif font-black uppercase tracking-tight leading-none text-[#2d1e10]">
        @restaurant?.Name
      </h1>
      <div class="h-[2px] bg-black my-4"></div>
      <p class="font-sans text-xs uppercase tracking-[0.4em] font-black italic">
        GELENEKSEL LEZZETLERİN EN GÜVENİLİR VE TESCİLLİ GAZETESİ
      </p>
    </header>

    <!-- Vintage Column Categorization Bar -->
    <nav class="border-b-4 border-black py-2 mb-12 overflow-x-auto no-scrollbar">
      <div class="flex justify-around gap-4 min-w-max font-sans text-xs uppercase tracking-widest font-black">
        @foreach (var cat in categories)
        {
          <button onclick="scrollToVintageCategory('vintage-cat-@cat.Id')"
                  class="hover:underline transition-all text-stone-900 bg-transparent border-none cursor-pointer">
            * @cat.Name *
          </button>
        }
      </div>
    </nav>

    <!-- Traditional dual-column paper list -->
    <main class="space-y-16">
      @foreach (var cat in categories)
      {
        var items = menuItems.Where(i => i.CategoryId == cat.Id).ToList();
        if (!items.Any()) continue;

        <section id="vintage-cat-@cat.Id" class="scroll-mt-24">
          <div class="text-center mb-8 border-b-2 border-black/80 pb-2">
            <h3 class="text-3xl font-serif font-bold italic uppercase tracking-wider text-[#2d1e10]">
              @cat.Name Bölümü
            </h3>
            <p class="font-sans text-[10px] tracking-widest text-stone-500 uppercase mt-1">
              [ GÜNLÜK OLARAK TAZE HAZIRLANMAKTADIR ]
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
            @foreach (var item in items)
            {
              <div class="flex flex-col justify-between group">
                <div>
                  <!-- Title ............. Price style row -->
                  <div class="flex justify-between items-baseline gap-2 mb-1">
                    <h4 class="text-lg font-bold font-serif text-[#2d1e10] group-hover:underline">
                      @item.Name
                    </h4>
                    <!-- Dotted separator -->
                    <div class="flex-1 border-b border-dashed border-[#8d7c66] mx-2"></div>
                    <span class="font-mono text-sm font-bold shrink-0 text-[#5c4033]">
                      @item.Price.ToString("N0") ₺
                    </span>
                  </div>
                  <p class="text-[#4e4337] text-sm font-sans leading-relaxed">
                    @(string.IsNullOrWhiteSpace(item.Description) ? "Mevsim taze malzemeleriyle hazırlanmış geleneksel tarifimiz." : item.Description)
                  </p>
                </div>
                @if (item.Price > 400)
                {
                  <div class="mt-2 text-[9px] font-sans font-bold uppercase tracking-widest text-[#5c4033] italic">
                    :: Tavsiye Olunur ::
                  </div>
                }
              </div>
            }
          </div>
        </section>
      }

      <!-- Newspaper Note Ad Block (İsteğe Bağlı) -->
      @if (!string.IsNullOrWhiteSpace(restaurant?.ImportantNotice) || restaurant?.Id == 0)
      {
        var notice = !string.IsNullOrWhiteSpace(restaurant?.ImportantNotice)
          ? restaurant.ImportantNotice
          : "Menü fiyatlarımıza KDV dahildir. Özel istek ve alerjenleriniz için lütfen servis personelimize danışınız.";

        <div class="border-4 border-black p-8 text-center bg-[#f4eedb] max-w-2xl mx-auto my-16">
          <span class="font-sans text-xs font-black uppercase tracking-[0.3em] block mb-2 text-[#2d1e10]">
            - RESMİ TEBLİĞAT &amp; BİLGİLENDİRME -
          </span>
          <p class="text-xl md:text-2xl font-serif italic text-black leading-relaxed mb-4">
            "@notice"
          </p>
          <p class="font-sans text-[10px] uppercase tracking-widest text-stone-600">
            * Tesisimizde hijyen kuralları en üst mertebede uygulanmaktadır.
          </p>
        </div>
      }
    </main>

    <!-- Vintage Footer -->
    <footer class="border-t-4 border-black pt-10 mt-16 text-center text-xs font-sans text-stone-600">
      <p class="font-bold uppercase tracking-widest mb-4 text-[#2d1e10]">
        @restaurant?.Name VE MAHDUMLARI
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8 text-[11px]">
        <div>İRTİBAT: @(string.IsNullOrWhiteSpace(restaurant?.Phone) ? "+90 555 000 00 00" : restaurant.Phone)</div>
        <div>ADRES: @(string.IsNullOrWhiteSpace(restaurant?.Address) ? "Atatürk Cad. No: 123 Hatay" : restaurant.Address)</div>
        <div>SAATLER: @(string.IsNullOrWhiteSpace(restaurant?.WorkingHours) ? "11:00 - 23:00" : restaurant.WorkingHours)</div>
      </div>

      @if (!string.IsNullOrWhiteSpace(restaurant?.GoogleMapsUrl))
      {
        var mapsUrl = restaurant.GoogleMapsUrl;
        <div class="mb-8 max-w-md mx-auto">
          @if (mapsUrl.Contains("embed"))
          {
            <div class="border-2 border-black">
              <iframe src="@mapsUrl" class="w-full h-44 border-0" allowfullscreen="" loading="lazy"></iframe>
            </div>
          }
          else
          {
            <a href="@mapsUrl" target="_blank" rel="noopener" class="inline-block border-2 border-black bg-black text-white px-6 py-2 uppercase font-black tracking-widest text-[10px] hover:bg-white hover:text-black transition-colors">
              [ 📍 HARİTAYI AÇ &amp; YOL TARİFİ AL ]
            </a>
          }
        </div>
      }

      <div class="border-t border-black/30 pt-6 text-[10px] uppercase tracking-wider text-center">
        <span>© @DateTime.Now.Year @restaurant?.Name POSTASI. HER HAKKI MAHFUZDUR.</span>
      </div>
    </footer>
  </div>
</div>

<script>
function scrollToVintageCategory(catId) {
  const element = document.getElementById(catId);
  if (element) {
    element.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
}
</script>

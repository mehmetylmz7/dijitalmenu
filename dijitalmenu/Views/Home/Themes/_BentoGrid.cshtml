@{
    var restaurant = ViewBag.Restaurant as EntityLayer.Concrete.Restaurant;
    var categories = ViewBag.Categories as List<EntityLayer.Concrete.Category> ?? new();
    var menuItems  = ViewBag.MenuItems  as List<EntityLayer.Concrete.MenuItem>  ?? new();

    var foodImages = new[]
    {
        "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&q=80&w=400",
        "https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&q=80&w=400",
        "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&q=80&w=400",
        "https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&fit=crop&q=80&w=400",
    };
}

<div class="bg-[#f8fafc] text-[#0f172a] min-h-screen font-sans selection:bg-amber-600 selection:text-white">
  <!-- Modern Block Header -->
  <header class="max-w-6xl mx-auto px-6 pt-16 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="md:col-span-2 bg-gradient-to-br from-stone-900 to-stone-850 text-white p-10 rounded-[2.5rem] flex flex-col justify-between shadow-sm text-left">
        <div class="flex items-center gap-2 text-amber-400 font-bold tracking-widest text-[10px] uppercase">
          <i class="fa-solid fa-compass animate-spin-slow"></i> EXPLORER
        </div>
        <div class="mt-8">
          <h1 class="text-4xl md:text-6xl font-serif font-black mb-3">
            @restaurant?.Name
          </h1>
          <p class="text-stone-300 text-sm md:text-base max-w-xl">
            Bento-grid düzeni ile hazırlanmış, kategorize edilmiş taze ve tescilli Anadolu gastronomi seçkisi.
          </p>
        </div>
      </div>
      <div class="bg-amber-100 p-10 rounded-[2.5rem] flex flex-col justify-between border border-amber-200 text-left">
        <span class="text-[10px] font-bold tracking-widest text-amber-800 uppercase">
          ADRES &amp; SAAT
        </span>
        <div>
          <h4 class="text-xl font-bold font-serif text-amber-900 mb-2">Merkez Şube</h4>
          <p class="text-sm text-amber-800 leading-relaxed">
            Atatürk Caddesi, No: 123 <br />
            Hatay, Türkiye <br />
            Hergün: 10:00 - 00:00
          </p>
        </div>
      </div>
    </div>
  </header>

  <!-- Grid Categories Selector Bar -->
  <nav class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-stone-200 shadow-sm overflow-x-auto no-scrollbar">
    <div class="max-w-6xl mx-auto flex py-4 px-6 gap-3 min-w-max">
      @foreach (var cat in categories)
      {
        <button onclick="scrollToBentoCategory('bento-cat-@cat.Id')"
                class="px-5 py-2.5 bg-stone-100 hover:bg-amber-600 hover:text-white text-stone-700 font-bold text-xs rounded-2xl tracking-wide uppercase transition-all duration-300 border-none cursor-pointer">
          @cat.Name
        </button>
      }
    </div>
  </nav>

  <!-- Main Bento Blocks Grid -->
  <main class="max-w-6xl mx-auto px-6 py-12">
    @foreach (var cat in categories)
    {
      var items = menuItems.Where(i => i.CategoryId == cat.Id).ToList();
      if (!items.Any()) continue;

      <section id="bento-cat-@cat.Id" class="mb-20 scroll-mt-24 text-left">
        <div class="flex items-center gap-4 mb-8">
          <i class="fa-solid fa-square-poll-horizontal text-amber-600 text-xl"></i>
          <h3 class="text-2xl font-serif font-black text-stone-800 uppercase tracking-tight">
            @cat.Name
          </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          @for (int i = 0; i < items.Count; i++)
          {
            var item = items[i];
            var isLarge = i % 4 == 0;
            var img = foodImages[item.Id % foodImages.Length];
            
            <div class="bg-white border border-stone-200/80 rounded-[2rem] overflow-hidden hover:border-amber-500/40 hover:shadow-xl transition-all duration-300 flex flex-col @(isLarge ? "md:col-span-2" : "")">
              <div class="relative overflow-hidden bg-stone-50 @(isLarge ? "h-72" : "h-52")">
                <img src="@img" 
                     alt="@item.Name" 
                     class="w-full h-full object-cover" />
                @if (item.Price > 400)
                {
                  <div class="absolute top-4 left-4 bg-amber-600 text-white text-[9px] uppercase font-bold tracking-widest px-3 py-1 rounded-xl">
                    Şefin İmzası
                  </div>
                }
              </div>
              <div class="p-8 flex flex-col flex-1 justify-between">
                <div>
                  <div class="flex justify-between items-start gap-4 mb-2">
                    <h4 class="text-xl font-bold font-serif text-stone-950">
                      @item.Name
                    </h4>
                    <span class="text-lg font-black text-amber-700 whitespace-nowrap">
                      @item.Price.ToString("N0") ₺
                    </span>
                  </div>
                  <p class="text-stone-500 text-sm leading-relaxed">
                    @(string.IsNullOrWhiteSpace(item.Description) ? "Zengin yöresel malzemeler ile günlük taze hazırlanan bento tabağımız." : item.Description)
                  </p>
                </div>
              </div>
            </div>
          }
        </div>
      </section>
    }

    <!-- Notes Bento Box -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-16 text-left">
      <div class="md:col-span-2 bg-stone-900 text-stone-100 p-10 rounded-[2.5rem] flex flex-col justify-between">
        <h4 class="text-amber-400 font-bold uppercase tracking-wider text-xs mb-4">
          SERVİS NOTU
        </h4>
        <p class="text-2xl font-serif font-medium leading-relaxed text-white mb-6">
          "Kendi alkolünü yanında getiren misafirlerimizden kişi başı <span class="text-amber-400 font-bold underline">100 TL</span> servis ücreti alınmaktadır."
        </p>
        <p class="text-stone-500 text-xs">
          * Tüm ürünlerimiz yerel üreticilerden doğrudan temin edilmektedir.
        </p>
      </div>
      <div class="bg-stone-200 p-10 rounded-[2.5rem] flex flex-col justify-between border border-stone-300">
        <span class="text-[10px] font-bold tracking-widest text-stone-500 uppercase">
          REZERVASYON
        </span>
        <div>
          <p class="text-sm font-semibold text-stone-700">
            En taze Hatay mezelerini yerinde tatmak için masanızı ayırtın.
          </p>
          <p class="text-lg font-serif font-bold text-stone-900 mt-4">
            +90 555 000 00 00
          </p>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-white border-t border-stone-200 py-12 px-6 text-xs text-stone-500">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6 text-center md:text-left">
      <div class="font-serif text-lg font-bold text-stone-800">@restaurant?.Name</div>
      <div>© @DateTime.Now.Year @restaurant?.Name. HER HAKKI SAKLIDIR.</div>
    </div>
  </footer>
</div>

<script>
function scrollToBentoCategory(catId) {
  const element = document.getElementById(catId);
  if (element) {
    element.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
}
</script>

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Dijital Menü</title>
    <meta name="description" content="QR kodla açılan, modern ve kolay yönetilen dijital restoran menü platformu." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
    <style>
        *,*::before,*::after{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:'DM Sans',sans-serif;background:#fafaf9;color:#1c1917;-webkit-font-smoothing:antialiased}.site-header{position:fixed;inset:0 0 auto;z-index:100;height:72px;background:rgba(250,250,249,.82);backdrop-filter:blur(18px);border-bottom:1px solid rgba(28,25,23,.08)}.nav-container{max-width:1180px;height:100%;margin:auto;padding:0 24px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand-logo{display:flex;align-items:center;gap:10px;color:#1c1917;text-decoration:none;font-family:Manrope;font-weight:800;letter-spacing:-.04em}.brand-icon{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;background:#064e3b;color:#fbbf24;font-size:15px;box-shadow:0 8px 20px rgba(6,78,59,.2)}.nav-menu{display:flex;gap:30px}.nav-link,.footer-link{color:#78716c;text-decoration:none;font-size:13px;font-weight:600;transition:color .2s}.nav-link:hover,.footer-link:hover{color:#047857}.nav-actions{display:flex;gap:10px;align-items:center}.btn-nav-login,.btn-nav-primary{padding:10px 16px;border-radius:999px;text-decoration:none;font-size:13px;font-weight:700;transition:.25s}.btn-nav-login{color:#44403c;border:1px solid #e7e5e4}.btn-nav-login:hover{background:#fff}.btn-nav-primary{background:#064e3b;color:#fff;box-shadow:0 8px 18px rgba(6,78,59,.18)}.btn-nav-primary:hover{background:#047857;transform:translateY(-1px)}main{padding-top:72px;min-height:calc(100vh - 72px)}.site-footer{padding:42px 24px;border-top:1px solid #e7e5e4;background:#f5f5f4}.footer-container{max-width:1180px;margin:auto;display:flex;justify-content:space-between;gap:24px;align-items:center}.footer-brand{display:flex;flex-direction:column;gap:8px}.footer-logo{color:#1c1917;text-decoration:none;font-family:Manrope;font-weight:800}.footer-text{margin:0;color:#a8a29e;font-size:12px}.footer-links{display:flex;gap:22px;flex-wrap:wrap}@media(max-width:720px){.nav-menu{display:none}.nav-container{padding:0 16px}.btn-nav-login{display:none}.footer-container{flex-direction:column;align-items:flex-start}.site-footer{padding:32px 16px}}
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<header class="site-header"><div class="nav-container"><a class="brand-logo" asp-controller="Home" asp-action="Index"><span class="brand-icon">DM</span><span>Dijital Menü</span></a><nav class="nav-menu"><a class="nav-link" href="/#features">Özellikler</a><a class="nav-link" href="/#how-it-works">Nasıl Çalışır?</a><a class="nav-link" href="/#demo">Temalar</a></nav><div class="nav-actions"><a class="btn-nav-login" asp-area="Restaurant" asp-controller="Auth" asp-action="Login">Giriş Yap</a><a class="btn-nav-primary" asp-area="Restaurant" asp-controller="Auth" asp-action="Register">Ücretsiz Başla</a></div></div></header>
<main>@RenderBody()</main>
<footer class="site-footer"><div class="footer-container"><div class="footer-brand"><a class="footer-logo" asp-controller="Home" asp-action="Index">Dijital Menü</a><p class="footer-text">© @DateTime.Now.Year Dijital Menü. Tüm hakları saklıdır.</p></div><div class="footer-links"><a class="footer-link" href="/#features">Özellikler</a><a class="footer-link" href="/#demo">Temalar</a><a class="footer-link" asp-area="Restaurant" asp-controller="Auth" asp-action="Login">Restoran Girişi</a><a class="footer-link" asp-area="Admin" asp-controller="Auth" asp-action="Login">Admin Paneli</a></div></div></footer>
@await RenderSectionAsync("Scripts", required: false)
</body></html>

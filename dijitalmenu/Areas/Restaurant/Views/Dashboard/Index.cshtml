@{ ViewData["Title"] = "Dashboard"; }
@section Styles {<style>.dashboard-shell{max-width:1180px;margin:auto;padding:44px 24px}.dashboard-title{font:800 36px Manrope;letter-spacing:-.06em;margin:0 0 8px;color:#1c1917}.dashboard-subtitle{color:#78716c;margin:0 0 30px}.stat-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-bottom:18px}.stat-card,.card{background:#fff;border:1px solid #e7e5e4;border-radius:20px;box-shadow:0 12px 30px rgba(28,25,23,.05)}.stat-card{padding:24px}.stat-icon{color:#047857;font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.stat-label{margin-top:26px;color:#78716c;font-size:13px}.stat-value{font:800 40px Manrope;letter-spacing:-.06em;margin-top:5px}.card{padding:26px;margin-bottom:18px}.card-header{display:flex;justify-content:space-between;align-items:center;gap:15px;border-bottom:1px solid #f5f5f4;padding-bottom:18px;margin-bottom:20px}.card-header h5{font:700 18px Manrope;margin:0}.card-body{color:#78716c}.btn{display:inline-flex;align-items:center;gap:8px;padding:11px 15px;border-radius:10px;text-decoration:none;font-weight:700;font-size:13px;border:1px solid #e7e5e4}.btn-primary{background:#064e3b;color:#fff;border-color:#064e3b}.btn-secondary{background:#fafaf9;color:#44403c}.btn:hover{transform:translateY(-1px)}@@media(max-width:640px){.dashboard-shell{padding:28px 16px}.stat-grid{grid-template-columns:1fr}.card{padding:20px}}</style>}
<div class="dashboard-shell"><h1 class="dashboard-title">Günaydın, menünüz hazır.</h1><p class="dashboard-subtitle">Restoranınızın dijital vitrini için hızlı özet.</p><div class="stat-grid"><div class="stat-card"><div class="stat-icon">Katalog</div><div class="stat-label">Toplam kategori</div><div class="stat-value">@ViewBag.CategoryCount</div></div><div class="stat-card"><div class="stat-icon">Ürünler</div><div class="stat-label">Toplam ürün</div><div class="stat-value">@ViewBag.MenuItemCount</div></div></div><div class="card"><div class="card-header"><h5>Hızlı işlemler</h5></div><div class="card-body" style="display:flex;gap:10px;flex-wrap:wrap"><a asp-area="Restaurant" asp-controller="Category" asp-action="Create" class="btn btn-primary">Yeni kategori</a><a asp-area="Restaurant" asp-controller="MenuItem" asp-action="Create" class="btn btn-primary">Yeni ürün</a><a asp-area="Restaurant" asp-controller="Category" asp-action="Index" class="btn btn-secondary">Kategorileri yönet</a><a asp-area="Restaurant" asp-controller="MenuItem" asp-action="Index" class="btn btn-secondary">Ürünleri yönet</a><a asp-area="Restaurant" asp-controller="Builder" asp-action="Index" class="btn btn-secondary">Menü oluşturucu</a></div></div><div class="card"><div class="card-header"><h5>Canlı menü ve QR kod</h5><span style="color:#047857;font-size:12px;font-weight:700">YAYINDA</span></div><div class="card-body" style="text-align:center;display:flex;flex-direction:column;align-items:center;gap:18px">@if (ViewBag.QrCodeImage != null){<div style="padding:16px;border:1px solid #e7e5e4;border-radius:18px;background:#fff"><img src="@ViewBag.QrCodeImage" alt="Restoran QR Kodu" style="max-width:220px;width:100%;display:block" /></div><div style="max-width:650px;width:100%;padding:16px;border-radius:14px;background:#fafaf9;word-break:break-all"><a href="@ViewBag.MenuUrl" target="_blank" rel="noopener" style="color:#047857;font-weight:700;text-decoration:none">@ViewBag.MenuUrl</a></div><div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center"><a href="@ViewBag.QrCodeImage" download="Menu_QRCode.png" class="btn btn-primary">QR kodu indir</a><a href="@ViewBag.PublicQrImageUrl" target="_blank" rel="noopener" class="btn btn-secondary">QR görselini aç</a></div>}else{<p>QR kod oluşturulamadı. Lütfen restoran bilgilerinizi güncelleyin.</p>}</div></div></div>

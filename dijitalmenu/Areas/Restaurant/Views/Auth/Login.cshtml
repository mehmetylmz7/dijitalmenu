@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Restoran Girişi — Dijital Menü</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', sans-serif; background: #0d1117; color: #e6edf3; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .bg { position: fixed; inset: 0; background: radial-gradient(ellipse at 30% 50%, rgba(34,197,94,.12) 0%, transparent 60%); }
        .card { position: relative; background: #161b22; border: 1px solid #30363d; border-radius: 24px; padding: 48px 44px; width: 100%; max-width: 420px; box-shadow: 0 25px 60px rgba(0,0,0,.5); }
        .logo { text-align: center; margin-bottom: 32px; }
        .logo .emoji { font-size: 3rem; display: block; margin-bottom: 12px; }
        .logo h1 { font-size: 1.5rem; font-weight: 700; background: linear-gradient(135deg, #22c55e, #4ade80); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .logo p { font-size: .85rem; color: #7d8590; margin-top: 4px; }
        .form-group { margin-bottom: 18px; }
        .form-label { display: block; font-size: .85rem; font-weight: 500; color: #7d8590; margin-bottom: 8px; }
        .form-control { width: 100%; padding: 12px 16px; background: #1c2128; border: 1px solid #30363d; border-radius: 12px; color: #e6edf3; font-size: .9rem; font-family: inherit; outline: none; transition: border-color .2s; }
        .form-control:focus { border-color: #22c55e; }
        .btn-submit { width: 100%; padding: 13px; background: linear-gradient(135deg, #22c55e, #4ade80); border: none; border-radius: 12px; color: #0d1117; font-size: 1rem; font-weight: 700; font-family: inherit; cursor: pointer; margin-top: 8px; transition: opacity .2s, transform .2s; }
        .btn-submit:hover { opacity: .9; transform: translateY(-1px); }
        .alert-error { background: rgba(248,81,73,.1); border: 1px solid rgba(248,81,73,.3); border-radius: 10px; padding: 12px 16px; color: #f85149; font-size: .875rem; margin-bottom: 20px; }
        .footer-link { text-align: center; margin-top: 20px; font-size: .85rem; color: #7d8590; }
        .footer-link a { color: #4ade80; text-decoration: none; }
    </style>
</head>
<body>
    <div class="bg"></div>
    <div class="card">
        <div class="logo">
            <span class="emoji">🍃</span>
            <h1>Restoran Paneli</h1>
            <p>Hesabınıza giriş yapın</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert-error">⚠️ @ViewBag.Error</div>
        }

        <form method="post" asp-area="Restaurant" asp-controller="Auth" asp-action="Login">
            <div class="form-group">
                <label class="form-label">Kullanıcı Adı</label>
                <input type="text" name="username" class="form-control" placeholder="kullaniciadi" required autofocus />
            </div>
            <div class="form-group">
                <label class="form-label">Şifre</label>
                <input type="password" name="password" class="form-control" placeholder="••••••••" required />
            </div>
            <button type="submit" class="btn-submit">Giriş Yap →</button>
        </form>

        <div class="footer-link">
            Hesabınız yok mu?
            <a asp-area="Restaurant" asp-controller="Auth" asp-action="Register">Ücretsiz kayıt olun</a>
        </div>
    </div>
</body>
</html>

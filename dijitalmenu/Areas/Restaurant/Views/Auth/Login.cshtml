@{ Layout = null; }
<!DOCTYPE html><html lang="tr"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Restoran Girişi — Dijital Menü</title><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@700;800&display=swap" rel="stylesheet" /><style>
*{box-sizing:border-box}body{margin:0;background:#1c1917;color:#fff;font-family:'DM Sans',sans-serif;min-height:100vh;display:grid;place-items:center;padding:20px;position:relative;overflow:hidden}body:before{content:'';position:absolute;width:620px;height:620px;border-radius:50%;background:radial-gradient(circle,rgba(16,185,129,.22),transparent 68%);top:-220px;right:-180px}.shell{width:min(100%,980px);display:grid;grid-template-columns:1fr 430px;min-height:560px;border:1px solid rgba(255,255,255,.12);border-radius:28px;overflow:hidden;background:rgba(41,37,36,.72);backdrop-filter:blur(20px);box-shadow:0 32px 100px rgba(0,0,0,.35)}.story{padding:54px;display:flex;flex-direction:column;justify-content:space-between;background:linear-gradient(145deg,rgba(6,78,59,.85),rgba(28,25,23,.2))}.brand{font:800 20px Manrope;letter-spacing:-.05em}.story h1{font:800 clamp(32px,4vw,54px)/1.04 Manrope;letter-spacing:-.06em;max-width:410px}.story p{color:#d6d3d1;line-height:1.7;max-width:390px}.aside{color:#a7f3d0;font-size:13px}.card{background:#fafaf9;color:#1c1917;padding:48px 42px;display:flex;flex-direction:column;justify-content:center}.card h2{font:800 28px Manrope;letter-spacing:-.05em;margin:0 0 8px}.muted{color:#78716c;font-size:14px;margin:0 0 28px}.form-group{margin-bottom:18px}.form-label{display:block;font-size:13px;font-weight:700;margin-bottom:8px}.form-control{width:100%;padding:13px 14px;border:1px solid #d6d3d1;border-radius:11px;background:#fff;font:inherit;outline:0;transition:.2s}.form-control:focus{border-color:#059669;box-shadow:0 0 0 4px rgba(16,185,129,.12)}.btn-submit{width:100%;border:0;border-radius:11px;padding:14px;background:#064e3b;color:#fff;font:700 14px inherit;cursor:pointer;transition:.2s}.btn-submit:hover{background:#047857;transform:translateY(-1px)}.alert-error{padding:12px;border-radius:10px;background:#fee2e2;border:1px solid #fecaca;color:#991b1b;font-size:13px;margin-bottom:18px}.footer-link{text-align:center;color:#78716c;font-size:13px;margin-top:22px}.footer-link a{color:#047857;font-weight:700;text-decoration:none}@@media(max-width:760px){.shell{display:block}.story{padding:28px;min-height:220px}.story h1{font-size:34px;margin:35px 0 0}.story p,.aside{display:none}.card{padding:36px 24px}}
</style></head><body><div class="shell"><section class="story"><div class="brand">Dijital Menü</div><div><h1>Menünüzü kontrol edin. Deneyimi yükseltin.</h1><p>Restoranınızın dijital vitrini, tek bir sade panelde.</p></div><div class="aside">Güvenli restoran paneli</div></section><section class="card"><h2>Tekrar hoş geldiniz.</h2><p class="muted">Yönetim hesabınıza giriş yapın.</p>@if (ViewBag.Error != null){<div class="alert-error">@ViewBag.Error</div>}<form method="post" asp-area="Restaurant" asp-controller="Auth" asp-action="Login"><div class="form-group"><label class="form-label" for="username">Kullanıcı adı</label><input type="text" id="username" name="username" class="form-control" placeholder="kullaniciadi" required autofocus autocomplete="username" /></div><div class="form-group"><label class="form-label" for="password">Şifre</label><input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required autocomplete="current-password" /></div><button type="submit" class="btn-submit">Giriş yap →</button></form><div class="footer-link">Henüz hesabınız yok mu? <a asp-area="Restaurant" asp-controller="Auth" asp-action="Register">Ücretsiz kayıt olun</a></div></section></div></body></html>

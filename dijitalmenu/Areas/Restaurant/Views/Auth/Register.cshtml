@{
    Layout = null;
    var themes = ViewBag.Themes as List<EntityLayer.Concrete.Theme> ?? new();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Restoran Kaydı — Dijital Menü</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            background: #0d1117;
            color: #e6edf3;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .bg {
            position: fixed; inset: 0;
            background: radial-gradient(ellipse at 70% 30%, rgba(34,197,94,.12) 0%, transparent 60%);
            pointer-events: none;
        }

        .card {
            position: relative;
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 24px;
            padding: 48px 44px;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 25px 60px rgba(0,0,0,.5);
        }

        .logo { text-align: center; margin-bottom: 32px; }
        .logo .emoji { font-size: 3rem; display: block; margin-bottom: 12px; }
        .logo h1 { font-size: 1.5rem; font-weight: 700; background: linear-gradient(135deg, #22c55e, #4ade80); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .logo p { font-size: .85rem; color: #7d8590; margin-top: 4px; }

        .section-divider {
            font-size: .7rem; font-weight: 600;
            text-transform: uppercase; letter-spacing: .08em;
            color: #7d8590; margin: 20px 0 12px;
            padding-top: 12px; border-top: 1px solid #21262d;
        }

        .form-group { margin-bottom: 16px; }
        .form-label { display: block; font-size: .85rem; font-weight: 500; color: #7d8590; margin-bottom: 8px; }

        .form-control {
            width: 100%; padding: 12px 16px;
            background: #1c2128; border: 1px solid #30363d;
            border-radius: 12px; color: #e6edf3;
            font-size: .9rem; font-family: inherit;
            outline: none; transition: border-color .2s;
        }
        .form-control:focus { border-color: #22c55e; }

        /* ─── Tema Başlık Satırı ─── */
        .theme-label-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 10px;
        }
        .theme-label-row .form-label { margin-bottom: 0; }
        .theme-hint {
            font-size: .72rem;
            color: #7d8590;
            font-style: italic;
        }

        /* ─── Temaları Keşfet Butonu ─── */
        .btn-explore {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            background: transparent;
            border: 1px solid #30363d;
            border-radius: 20px;
            color: #7d8590;
            font-size: .75rem;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            text-decoration: none;
            transition: border-color .2s, color .2s, background .2s;
        }
        .btn-explore:hover {
            border-color: #4ade80;
            color: #4ade80;
            background: rgba(74,222,128,.06);
        }
        .btn-explore .sparkle { font-size: .8rem; }

        /* ─── Tema Seçici Grid ─── */
        .theme-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            max-height: 320px;
            overflow-y: auto;
            padding-right: 4px;
        }
        .theme-grid::-webkit-scrollbar { width: 4px; }
        .theme-grid::-webkit-scrollbar-track { background: transparent; }
        .theme-grid::-webkit-scrollbar-thumb { background: #30363d; border-radius: 4px; }

        .theme-option {
            border: 2px solid #30363d;
            border-radius: 12px;
            overflow: hidden;
            cursor: pointer;
            transition: border-color .2s, transform .15s, box-shadow .2s;
            position: relative;
        }
        .theme-option:hover { border-color: #7d8590; transform: translateY(-2px); }
        .theme-option.selected {
            border-color: #22c55e;
            box-shadow: 0 0 0 3px rgba(34,197,94,.2);
        }
        .theme-option input[type="radio"] { display: none; }

        /* Renk Önizleme */
        .theme-swatch {
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            padding: 0 10px;
        }
        .swatch-dot {
            width: 10px; height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .swatch-bar {
            height: 5px; border-radius: 3px;
            flex: 1; opacity: .6;
        }

        /* Tema Adı */
        .theme-option-info {
            padding: 7px 10px 9px;
            border-top: 1px solid rgba(255,255,255,.06);
            background: rgba(0,0,0,.25);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .theme-option-name {
            font-size: .78rem;
            font-weight: 600;
            color: #e6edf3;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .theme-check {
            width: 18px; height: 18px;
            border-radius: 50%;
            border: 2px solid #30363d;
            display: flex; align-items: center; justify-content: center;
            font-size: .6rem;
            transition: all .2s;
            flex-shrink: 0;
        }
        .theme-option.selected .theme-check {
            background: #22c55e;
            border-color: #22c55e;
            color: #0d1117;
        }

        /* ─── Submit ─── */
        .btn-submit {
            width: 100%; padding: 13px;
            background: linear-gradient(135deg, #22c55e, #4ade80);
            border: none; border-radius: 12px;
            color: #0d1117; font-size: 1rem; font-weight: 700;
            font-family: inherit; cursor: pointer; margin-top: 12px;
            transition: opacity .2s, transform .2s;
        }
        .btn-submit:hover { opacity: .9; transform: translateY(-1px); }

        .alert-error {
            background: rgba(248,81,73,.1); border: 1px solid rgba(248,81,73,.3);
            border-radius: 10px; padding: 12px 16px;
            color: #f85149; font-size: .875rem; margin-bottom: 20px;
        }

        .footer-link { text-align: center; margin-top: 20px; font-size: .85rem; color: #7d8590; }
        .footer-link a { color: #4ade80; text-decoration: none; }

        @@media (max-width: 520px) {
            .card { padding: 36px 24px; }
            .theme-grid { grid-template-columns: repeat(2, 1fr); }
        }
    </style>
</head>
<body>
    <div class="bg"></div>
    <div class="card">
        <div class="logo">
            <span class="emoji">🍃</span>
            <h1>Ücretsiz Kaydolun</h1>
            <p>Restoranınız için dijital menü oluşturun</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert-error">⚠️ @ViewBag.Error</div>
        }

        <form method="post" asp-area="Restaurant" asp-controller="Auth" asp-action="Register" id="registerForm">

            <div class="section-divider">🏪 Restoran Bilgileri</div>

            <div class="form-group">
                <label class="form-label">Restoran Adı</label>
                <input type="text" name="restaurantName" class="form-control"
                       placeholder="Örn: Lezzet Köşesi" required autofocus />
            </div>

            <!-- Tema Seçimi -->
            <div class="form-group">
                <div class="theme-label-row">
                    <label class="form-label">🎨 Menü Teması</label>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <span class="theme-hint">Daha sonra değiştirebilirsiniz</span>
                        <a href="/Home/Preview" target="_blank" class="btn-explore">
                            <span class="sparkle">✨</span> Temaları Keşfet
                        </a>
                    </div>
                </div>

                <input type="hidden" name="themeId" id="selectedThemeId" value="@(themes.FirstOrDefault()?.Id ?? 0)" />

                @if (themes.Any())
                {
                    <div class="theme-grid">
                        @foreach (var theme in themes)
                        {
                            var isFirst = theme.Id == (themes.FirstOrDefault()?.Id ?? 0);
                            <div class="theme-option @(isFirst ? "selected" : "")"
                                 id="opt-@theme.Id"
                                 onclick="selectTheme(@theme.Id)">
                                <!-- Renk önizlemesi -->
                                <div class="theme-swatch" style="background: @theme.BackgroundColor;">
                                    <div class="swatch-dot" style="background: @theme.PrimaryColor;"></div>
                                    <div class="swatch-bar" style="background: @theme.PrimaryColor;"></div>
                                    <div class="swatch-dot" style="background: @theme.SecondaryColor; width:7px; height:7px;"></div>
                                </div>
                                <!-- Tema Adı & Check -->
                                <div class="theme-option-info">
                                    <span class="theme-option-name">@theme.Name</span>
                                    <div class="theme-check" id="chk-@theme.Id">✓</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p style="color:#7d8590; font-size:.85rem; padding: 12px 0;">
                        Henüz tema bulunamadı. Varsayılan tema atanacak.
                    </p>
                }
            </div>

            <div class="section-divider">🔐 Hesap Bilgileri</div>

            <div class="form-group">
                <label class="form-label">Kullanıcı Adı</label>
                <input type="text" name="username" class="form-control"
                       placeholder="benzersiz_kullanici_adi" required />
            </div>

            <div class="form-group">
                <label class="form-label">Şifre</label>
                <input type="password" name="password" class="form-control"
                       placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn-submit" id="submitBtn">
                Restoranımı Kur →
            </button>
        </form>

        <div class="footer-link">
            Zaten hesabınız var mı?
            <a asp-area="Restaurant" asp-controller="Auth" asp-action="Login">Giriş yapın</a>
        </div>
    </div>

    <script>
        function selectTheme(id) {
            // Hidden input güncelle
            document.getElementById('selectedThemeId').value = id;

            // Önceki seçimi kaldır
            document.querySelectorAll('.theme-option').forEach(el => el.classList.remove('selected'));

            // Yeni seçimi aktif yap
            document.getElementById('opt-' + id).classList.add('selected');
        }
    </script>
</body>
</html>

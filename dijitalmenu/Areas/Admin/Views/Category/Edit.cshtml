@model EntityLayer.Concrete.Category
@{
    ViewData["Title"] = "Kategori Düzenle";
}
<div class="card" style="max-width:600px;">
    <div class="card-header"><h5>✏️ Kategori Düzenle</h5></div>
    <div class="card-body">
        <form method="post" asp-action="Edit">
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="form-group">
                <label class="form-label">Kategori Adı</label>
                <input type="text" name="Name" value="@Model.Name" class="form-control" required />
            </div>
            <div class="form-group">
                <label class="form-label">Menü</label>
                <select name="MenuId" class="form-control">
                    @foreach (var menu in ViewBag.Menus as List<EntityLayer.Concrete.Menu>)
                    {
                        if (menu.Id == Model.MenuId)
                        {
                            <option value="@menu.Id" selected>Menü #@menu.Id</option>
                        }
                        else
                        {
                            <option value="@menu.Id">Menü #@menu.Id</option>
                        }
                    }
                </select>
            </div>
            <div style="display:flex;gap:10px;margin-top:8px;">
                <button type="submit" class="btn btn-primary">💾 Güncelle</button>
                <a asp-action="Index" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>

@{
    ViewData["Title"] = "Yeni Kategori";
}
<div class="card" style="max-width:600px;">
    <div class="card-header"><h5>🏷️ Yeni Kategori Ekle</h5></div>
    <div class="card-body">
        <form method="post" asp-action="Create">
            <div class="form-group">
                <label class="form-label">Kategori Adı</label>
                <input type="text" name="Name" class="form-control" placeholder="Örn: Ana Yemekler" required />
            </div>
            <div class="form-group">
                <label class="form-label">Menü</label>
                <select name="MenuId" class="form-control">
                    @foreach (var menu in ViewBag.Menus as List<EntityLayer.Concrete.Menu>)
                    {
                        <option value="@menu.Id">Menü #@menu.Id</option>
                    }
                </select>
            </div>
            <div style="display:flex;gap:10px;margin-top:8px;">
                <button type="submit" class="btn btn-primary">💾 Kaydet</button>
                <a asp-action="Index" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>

@model List<EntityLayer.Concrete.Category>
@{
    ViewData["Title"] = "Kategoriler";
}
<div class="card">
    <div class="card-header">
        <h5>🏷️ Kategori Listesi</h5>
        <a asp-action="Create" class="btn btn-primary btn-sm">➕ Yeni Ekle</a>
    </div>
    <table>
        <thead>
            <tr><th>#</th><th>Ad</th><th>Menü ID</th><th>İşlemler</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><span class="badge badge-purple">@item.Id</span></td>
                    <td>@item.Name</td>
                    <td>@item.MenuId</td>
                    <td style="display:flex;gap:8px;">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">✏️ Düzenle</a>
                        <partial name="~/Views/Shared/_DeleteButton.cshtml" model="item.Id" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@model EntityLayer.Concrete.User
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}
<div class="card" style="max-width:600px;">
    <div class="card-header"><h5>✏️ Kullanıcı Düzenle</h5></div>
    <div class="card-body">
        <form method="post" asp-action="Edit">
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="form-group">
                <label class="form-label">Kullanıcı Adı</label>
                <input type="text" name="Username" value="@Model.Username" class="form-control" required />
            </div>
            <div class="form-group">
                <label class="form-label">Şifre</label>
                <input type="password" name="Password" class="form-control" placeholder="Değiştirmek için girin" />
            </div>
            <div class="form-group">
                <label class="form-label">Restoran</label>
                <select name="RestaurantId" class="form-control">
                    @foreach (var r in ViewBag.Restaurants as List<EntityLayer.Concrete.Restaurant>)
                    {
                        if (r.Id == Model.RestaurantId)
                        {
                            <option value="@r.Id" selected>@r.Name</option>
                        }
                        else
                        {
                            <option value="@r.Id">@r.Name</option>
                        }
                    }
                </select>
            </div>
            <div style="display:flex;gap:10px;margin-top:8px;">
                <button type="submit" class="btn btn-primary">💾 Güncelle</button>
                <a asp-action="Index" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>

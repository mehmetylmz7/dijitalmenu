@model EntityLayer.Concrete.Restaurant
@{
    ViewData["Title"] = "Restoran Düzenle";
}
<div class="card" style="max-width:600px;">
    <div class="card-header"><h5>✏️ Restoran Düzenle</h5></div>
    <div class="card-body">
        <form method="post" asp-action="Edit">
            <input type="hidden" name="Id" value="@Model.Id" />
            <div class="form-group">
                <label class="form-label">Restoran Adı</label>
                <input type="text" name="Name" value="@Model.Name" class="form-control" required />
            </div>
            <div class="form-group">
                <label class="form-label">Tema</label>
                <select name="ThemeId" class="form-control">
                    @foreach (var theme in ViewBag.Themes as List<EntityLayer.Concrete.Theme>)
                    {
                        if (theme.Id == Model.ThemeId)
                        {
                            <option value="@theme.Id" selected>@theme.Name</option>
                        }
                        else
                        {
                            <option value="@theme.Id">@theme.Name</option>
                        }
                    }
                </select>
            </div>
            <div style="display:flex;gap:10px;margin-top:8px;">
                <button type="submit" class="btn btn-primary">💾 Güncelle</button>
                <a asp-action="Index" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>

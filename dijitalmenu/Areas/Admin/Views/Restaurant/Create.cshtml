@{
    ViewData["Title"] = "Yeni Restoran";
}
<div class="card" style="max-width:600px;">
    <div class="card-header"><h5>🏪 Yeni Restoran Ekle</h5></div>
    <div class="card-body">
        <form method="post" asp-action="Create">
            <div class="form-group">
                <label class="form-label">Restoran Adı</label>
                <input type="text" name="Name" class="form-control" placeholder="Restoran adını girin" required />
            </div>
            <div class="form-group">
                <label class="form-label">Tema</label>
                <select name="ThemeId" class="form-control">
                    @foreach (var theme in ViewBag.Themes as List<EntityLayer.Concrete.Theme>)
                    {
                        <option value="@theme.Id">@theme.Name</option>
                    }
                </select>
            </div>
            <div style="display:flex;gap:10px;margin-top:8px;">
                <button type="submit" class="btn btn-primary">💾 Kaydet</button>
                <a asp-action="Index" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>

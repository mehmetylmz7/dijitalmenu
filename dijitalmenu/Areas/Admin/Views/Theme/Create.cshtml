@{
    ViewData["Title"] = "Yeni Tema";
}
<div class="card" style="max-width:600px;">
    <div class="card-header"><h5>🎨 Yeni Tema Ekle</h5></div>
    <div class="card-body">
        <form method="post" asp-action="Create">
            <div class="form-group">
                <label class="form-label">Tema Adı</label>
                <input type="text" name="Name" class="form-control" placeholder="Örn: Klasik, Modern, Rustik" required />
            </div>

            <div class="form-group" style="margin-top: 16px;">
                <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
                    <input type="checkbox" name="IsActive" value="true" checked style="width: 18px; height: 18px; accent-color: var(--accent);" />
                    <span style="font-weight: 500; font-size: 0.9rem;">Tema Aktif (Menü galerisinde ve oluşturucuda görünsün)</span>
                </label>
                <input type="hidden" name="IsActive" value="false" />
            </div>

            <div style="display:flex;gap:10px;margin-top:24px;">
                <button type="submit" class="btn btn-primary">💾 Kaydet</button>
                <a asp-action="Index" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>
